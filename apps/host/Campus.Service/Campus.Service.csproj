<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      WinExe rather than Exe: this process has a message loop but never a console window, and a
      background helper that flashes a black rectangle at sign-in is a background helper nobody
      keeps enabled.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Campus.Service</RootNamespace>
    <AssemblyName>Campus.Service</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>..\..\desktop\Campus.Desktop\Assets\Campus.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
