<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        The one thing the app and its share extension share. Nothing else crosses between them:
        the outbox itself stays in Documents, where a cable can read it.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.campus.pocket</string>
    </array>
</dict>
</plist>
