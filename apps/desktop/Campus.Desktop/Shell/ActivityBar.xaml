<UserControl
    x:Class="Campus.Desktop.Shell.ActivityBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Campus.Desktop.Localization"
    xmlns:local="using:Campus.Desktop.Shell"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <!--
            One rail item. Selection is shown three ways at once — a filled icon, a raised fill,
            and an accent bar down the leading edge — so it never depends on colour alone.
        -->
        <DataTemplate x:Key="DestinationTemplate" x:DataType="local:ShellDestination">
            <Grid Height="{StaticResource Theme.Size.ActivityItem}"
                  Width="{StaticResource Theme.Size.ActivityBarWidth}">
                <Button
                    Style="{StaticResource Button.Plain}"
                    Width="40" Height="40"
                    Padding="0"
                    CornerRadius="{StaticResource Theme.Radius.M}"
                    HorizontalAlignment="Center"
                    Click="OnDestinationClick"
                    Tag="{x:Bind Id}"
                    AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind TooltipText}"
                    ToolTipService.Placement="Right">
                    <Grid>
                        <icons:CampusIcon
                            Symbol="{x:Bind Symbol}"
                            IconSize="{StaticResource Theme.Icon.XXL}"
                            Weight="{x:Bind local:ActivityBar.IconWeight(IsSelected), Mode=OneWay}"
                            Foreground="{x:Bind local:ActivityBar.IconBrush(IsSelected), Mode=OneWay}" />
                    </Grid>
                </Button>

                <!-- Selection rail, on the leading edge. -->
                <Border
                    Width="3" Height="22"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    CornerRadius="0,2,2,0"
                    Background="{ThemeResource Theme.Selected.Rail}"
                    Visibility="{x:Bind local:ActivityBar.SelectionVisibility(IsSelected), Mode=OneWay}" />

                <!-- Pending count. Sits on the icon's top-right, never covering its centre. -->
                <Border
                    Margin="0,4,6,0"
                    MinWidth="16" Height="16"
                    Padding="4,0,4,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    CornerRadius="{StaticResource Theme.Radius.Pill}"
                    Background="{ThemeResource Theme.Accent.Primary}"
                    Visibility="{x:Bind local:ActivityBar.BadgeVisibility(Badge), Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind local:ActivityBar.BadgeText(Badge), Mode=OneWay}"
                        Foreground="{ThemeResource Theme.Label.OnAccent}"
                        FontSize="{StaticResource Theme.Text.Caption2}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{ThemeResource Theme.Background.Primary}"
          Width="{StaticResource Theme.Size.ActivityBarWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            VerticalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Disabled">
            <ItemsControl
                x:Name="MainItems"
                Margin="0,6,0,0"
                ItemTemplate="{StaticResource DestinationTemplate}"
                AutomationProperties.Name="{l:T Key=main.destinations}" />
        </ScrollViewer>

        <ItemsControl
            x:Name="BottomItems"
            Grid.Row="1"
            Margin="0,0,0,6"
            ItemTemplate="{StaticResource DestinationTemplate}"
            AutomationProperties.Name="{l:T Key=workspace.and.settings}" />
    </Grid>
</UserControl>
