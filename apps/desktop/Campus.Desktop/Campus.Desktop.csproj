<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Campus.Desktop</RootNamespace>
    <AssemblyName>Campus</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationIcon>Assets\Campus.ico</ApplicationIcon>
    <!--
      English only. The Windows App SDK ships translations for ninety languages, which is ninety
      folders and a hundred megabytes for strings Campus does not use — it draws its own text.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Available everywhere without a using line. `L.T("key")` appears in almost every file that
      draws anything, and a using directive per file to reach a two-letter helper is noise.
    -->
    <Using Include="Campus.Desktop.Localization" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core\Campus.Domain\Campus.Domain.csproj" />
    <ProjectReference Include="..\..\..\core\Campus.Vault\Campus.Vault.csproj" />
    <ProjectReference Include="..\..\..\core\Campus.Storage\Campus.Storage.csproj" />
    <ProjectReference Include="..\..\..\core\Campus.Documents\Campus.Documents.csproj" />
    <ProjectReference Include="..\..\..\core\Campus.Sync\Campus.Sync.csproj" />
    <ProjectReference Include="..\..\..\core\Campus.Extensions.Sdk\Campus.Extensions.Sdk.csproj" />
    <ProjectReference Include="..\..\..\core\Campus.Platform.Windows\Campus.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Campus.ico" />
    <Content Include="Assets\Campus.ico" Condition="Exists('Assets\Campus.ico')" />
    <None Remove="Assets\emoji.dat" />
    <Content Include="Assets\emoji.dat" Condition="Exists('Assets\emoji.dat')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Campus ships with three small programs beside it, each in a folder of its own.

      service      the only part allowed to run when Campus is not, and it holds no keys
      indexer      reads documents in a process that can crash without taking the app down
      pluginhost   runs one extension, isolated from everything

    They are built through MSBuild rather than referenced: a self-contained application cannot
    reference another executable, and these are separate programs rather than libraries.
  -->
  <Target Name="CopyService" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\host\Campus.Service\Campus.Service.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <ServiceOutput Include="$(MSBuildThisFileDirectory)..\..\host\Campus.Service\bin\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ServiceOutput)"
          DestinationFolder="$(OutDir)service\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(ServiceOutput)' != ''" />
  </Target>

  <Target Name="CopyIndexer" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\host\Campus.Indexer\Campus.Indexer.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <IndexerOutput Include="$(MSBuildThisFileDirectory)..\..\host\Campus.Indexer\bin\$(Configuration)\net10.0\win-x64\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(IndexerOutput)"
          DestinationFolder="$(OutDir)indexer\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(IndexerOutput)' != ''" />
  </Target>

  <Target Name="CopyPluginHost" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\host\Campus.PluginHost\Campus.PluginHost.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <PluginHostOutput Include="$(MSBuildThisFileDirectory)..\..\host\Campus.PluginHost\bin\$(Configuration)\net10.0\win-x64\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginHostOutput)"
          DestinationFolder="$(OutDir)pluginhost\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(PluginHostOutput)' != ''" />
  </Target>

  <!--
    The emoji artwork pack, if one is installed.

    Not listed as Content: a pack is nearly four thousand files, and enumerating them as items
    makes every build slower for something that changes when a pack is installed and never again.
    It is also optional — Campus draws no emoji at all without one, and says so.
  -->
  <Target Name="CopyEmojiPacks" AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)Assets\emoji-packs')">
    <ItemGroup>
      <EmojiPackFiles Include="$(MSBuildThisFileDirectory)Assets\emoji-packs\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(EmojiPackFiles)"
          DestinationFolder="$(OutDir)Assets\emoji-packs\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Publishing copies the build's output but not what was put beside it afterwards, so everything
    the three targets above produced is carried across here. Without this the published app is
    missing its helpers and its emoji, which is exactly the difference between a build that runs
    on this machine and one that runs on somebody else's.
  -->
  <Target Name="CopyCompanionsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <ServiceFiles Include="$(OutDir)service\**\*.*" />
      <IndexerFiles Include="$(OutDir)indexer\**\*.*" />
      <PluginHostFiles Include="$(OutDir)pluginhost\**\*.*" />
      <PackFiles Include="$(OutDir)Assets\emoji-packs\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(ServiceFiles)" SkipUnchangedFiles="true"
          DestinationFolder="$(PublishDir)service\%(RecursiveDir)"
          Condition="'@(ServiceFiles)' != ''" />
    <Copy SourceFiles="@(IndexerFiles)" SkipUnchangedFiles="true"
          DestinationFolder="$(PublishDir)indexer\%(RecursiveDir)"
          Condition="'@(IndexerFiles)' != ''" />
    <Copy SourceFiles="@(PluginHostFiles)" SkipUnchangedFiles="true"
          DestinationFolder="$(PublishDir)pluginhost\%(RecursiveDir)"
          Condition="'@(PluginHostFiles)' != ''" />
    <Copy SourceFiles="@(PackFiles)" SkipUnchangedFiles="true"
          DestinationFolder="$(PublishDir)Assets\emoji-packs\%(RecursiveDir)"
          Condition="'@(PackFiles)' != ''" />
  </Target>

  <!--
    Native debug symbols are not shipped.

    SkiaSharp's own .pdb is eighty-five megabytes, twice over, and it is of no use to anybody who
    is not debugging SkiaSharp. Campus's own symbols stay, because a stack trace without line
    numbers is a stack trace nobody can act on.
  -->
  <Target Name="DropNativeSymbols" AfterTargets="CopyCompanionsToPublish">
    <ItemGroup>
      <NativeSymbols Include="$(PublishDir)**\libSkiaSharp.pdb" />
      <NativeSymbols Include="$(PublishDir)**\pdfium.pdb" />
    </ItemGroup>
    <Delete Files="@(NativeSymbols)" ContinueOnError="true" />
  </Target>

</Project>
