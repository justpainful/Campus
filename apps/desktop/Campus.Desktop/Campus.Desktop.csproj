<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Campus.Desktop</RootNamespace>
    <AssemblyName>Campus</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationIcon>Assets\Campus.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core\Campus.Domain\Campus.Domain.csproj" />
    <ProjectReference Include="..\..\..\core\Campus.Vault\Campus.Vault.csproj" />
    <ProjectReference Include="..\..\..\core\Campus.Storage\Campus.Storage.csproj" />
    <ProjectReference Include="..\..\..\core\Campus.Documents\Campus.Documents.csproj" />
    <ProjectReference Include="..\..\..\core\Campus.Sync\Campus.Sync.csproj" />
    <ProjectReference Include="..\..\..\core\Campus.Extensions.Sdk\Campus.Extensions.Sdk.csproj" />
    <ProjectReference Include="..\..\..\core\Campus.Platform.Windows\Campus.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Campus.ico" />
    <Content Include="Assets\Campus.ico" Condition="Exists('Assets\Campus.ico')" />
    <None Remove="Assets\emoji.dat" />
    <Content Include="Assets\emoji.dat" Condition="Exists('Assets\emoji.dat')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The plugin host ships beside the app in a folder of its own, so an extension's dependencies
    can never be resolved out of Campus's own directory by accident.
  -->
  <!--
    The indexer ships beside the app too. It is a separate program so that a malformed document
    cannot take the workspace down with it.
  -->
  <Target Name="CopyIndexer" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\host\Campus.Indexer\Campus.Indexer.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <IndexerOutput Include="$(MSBuildThisFileDirectory)..\..\host\Campus.Indexer\bin\$(Configuration)\net10.0\win-x64\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(IndexerOutput)"
          DestinationFolder="$(OutDir)indexer\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(IndexerOutput)' != ''" />
  </Target>

  <Target Name="CopyPluginHost" AfterTargets="Build">
    <!--
      Built through MSBuild rather than referenced: a self-contained app cannot reference another
      executable, and the host is a separate program rather than a library this one links to.
    -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\host\Campus.PluginHost\Campus.PluginHost.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <PluginHostOutput Include="$(MSBuildThisFileDirectory)..\..\host\Campus.PluginHost\bin\$(Configuration)\net10.0\win-x64\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginHostOutput)"
          DestinationFolder="$(OutDir)pluginhost\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(PluginHostOutput)' != ''" />
  </Target>

</Project>
