<Page
    x:Class="Campus.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Campus.Desktop.Design.Controls"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    Background="{ThemeResource Theme.GroupedBackground.Primary}">

    <!--
        A grouped page: the canvas is the grouped background and the sections float on it. No
        section draws a border, and no row is a card of its own.
    -->
    <ScrollViewer Padding="0,0,0,40">
        <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Margin="24,20,24,0">

            <TextBlock Text="Settings" Style="{StaticResource Text.LargeTitle}" Margin="16,0,0,20" />

            <controls:SettingsSection
                Header="APPEARANCE"
                Footer="System follows Windows and updates the moment it changes — no restart.">
                <StackPanel>
                    <controls:SettingsRow
                        Title="Appearance"
                        Subtitle="How Campus decides between light and dark"
                        Symbol="contrast"
                        ShowSeparator="False">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <RadioButton x:Name="AppearanceSystem" Content="System"
                                         GroupName="Appearance" Checked="OnAppearanceChanged" Tag="System" />
                            <RadioButton x:Name="AppearanceLight" Content="Light"
                                         GroupName="Appearance" Checked="OnAppearanceChanged" Tag="Light" />
                            <RadioButton x:Name="AppearanceDark" Content="Dark"
                                         GroupName="Appearance" Checked="OnAppearanceChanged" Tag="Dark" />
                        </StackPanel>
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Theme gallery"
                        Subtitle="Every surface, label, fill and state in one place"
                        Symbol="palette">
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="Open" Click="OnOpenGalleryClick"
                                AutomationProperties.Name="Open theme gallery" />
                    </controls:SettingsRow>
                </StackPanel>
            </controls:SettingsSection>

            <controls:SettingsSection
                Header="ACCESSIBILITY"
                Footer="Anything Windows already enforces stays on here, whatever these switches say.">
                <StackPanel>
                    <controls:SettingsRow
                        Title="Increase contrast"
                        Subtitle="Separate surfaces further and make hairlines opaque"
                        Symbol="accessibility"
                        ShowSeparator="False">
                        <ToggleSwitch x:Name="ContrastToggle" OnContent="" OffContent=""
                                      Toggled="OnAccessibilityToggled"
                                      AutomationProperties.Name="Increase contrast" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Reduce motion"
                        Subtitle="Collapse transitions to nothing"
                        Symbol="speed">
                        <ToggleSwitch x:Name="MotionToggle" OnContent="" OffContent=""
                                      Toggled="OnAccessibilityToggled"
                                      AutomationProperties.Name="Reduce motion" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Reduce transparency"
                        Subtitle="Paint materials as solid surfaces"
                        Symbol="eye">
                        <ToggleSwitch x:Name="TransparencyToggle" OnContent="" OffContent=""
                                      Toggled="OnAccessibilityToggled"
                                      AutomationProperties.Name="Reduce transparency" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Large hit targets"
                        Subtitle="Grow every control to a comfortable 44 pixels"
                        Symbol="target">
                        <ToggleSwitch x:Name="HitTargetToggle" OnContent="" OffContent=""
                                      Toggled="OnAccessibilityToggled"
                                      AutomationProperties.Name="Large hit targets" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Always show focus ring"
                        Subtitle="Keep the keyboard focus visible even after a click"
                        Symbol="focus">
                        <ToggleSwitch x:Name="FocusRingToggle" OnContent="" OffContent=""
                                      Toggled="OnAccessibilityToggled"
                                      AutomationProperties.Name="Always show focus ring" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Text size"
                        Subtitle="Scales what you read without scaling the whole interface"
                        Symbol="text.size">
                        <Slider x:Name="TextScaleSlider" Width="200"
                                Minimum="80" Maximum="180" StepFrequency="10" TickFrequency="20"
                                ValueChanged="OnScaleChanged"
                                AutomationProperties.Name="Text size" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Interface size"
                        Subtitle="Scales icons, bars and rows"
                        Symbol="accessibility">
                        <Slider x:Name="UiScaleSlider" Width="200"
                                Minimum="80" Maximum="140" StepFrequency="10" TickFrequency="20"
                                ValueChanged="OnScaleChanged"
                                AutomationProperties.Name="Interface size" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Large mouse pointer"
                        Subtitle="Only Windows can change the pointer — this opens the setting"
                        Symbol="accessibility">
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="Open Windows settings" Click="OnPointerSettingsClick"
                                AutomationProperties.Name="Open Windows pointer settings" />
                    </controls:SettingsRow>
                </StackPanel>
            </controls:SettingsSection>

            <controls:SettingsSection
                Header="READING"
                Footer="These change how documents and notes are set, not how the interface looks.">
                <StackPanel>
                    <controls:SettingsRow
                        Title="Plainer reading face"
                        Subtitle="A wider, more open typeface for long passages"
                        Symbol="book"
                        ShowSeparator="False">
                        <ToggleSwitch x:Name="DyslexiaToggle" OnContent="" OffContent=""
                                      Toggled="OnAccessibilityToggled"
                                      AutomationProperties.Name="Plainer reading face" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Line spacing"
                        Subtitle="More air between lines of prose"
                        Symbol="text.size">
                        <Slider x:Name="LineSpacingSlider" Width="200"
                                Minimum="100" Maximum="200" StepFrequency="10" TickFrequency="25"
                                ValueChanged="OnScaleChanged"
                                AutomationProperties.Name="Line spacing" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Reading ruler"
                        Subtitle="A band that follows the pointer to keep your place"
                        Symbol="focus">
                        <ToggleSwitch x:Name="RulerToggle" OnContent="" OffContent=""
                                      Toggled="OnAccessibilityToggled"
                                      AutomationProperties.Name="Reading ruler" />
                    </controls:SettingsRow>
                </StackPanel>
            </controls:SettingsSection>

            <controls:SettingsSection
                Header="BACKUP"
                Footer="A backup is a copy of the vault exactly as it is on disk — already encrypted, and openable only with your recovery key. There is no way around that, which is the same reason the workspace is worth having.">
                <StackPanel>
                    <controls:SettingsRow
                        Title="Automatic backups"
                        Subtitle="Taken when Campus opens, if one is due"
                        Symbol="backup"
                        ShowSeparator="False">
                        <ToggleSwitch x:Name="BackupToggle" OnContent="" OffContent=""
                                      Toggled="OnBackupChanged"
                                      AutomationProperties.Name="Automatic backups" />
                    </controls:SettingsRow>

                    <controls:SettingsRow Title="How often" Symbol="clock">
                        <ComboBox x:Name="BackupCadenceChoice" MinWidth="150"
                                  SelectionChanged="OnBackupChanged"
                                  AutomationProperties.Name="Backup frequency">
                            <ComboBoxItem Content="Only when I ask" />
                            <ComboBoxItem Content="Daily" />
                            <ComboBoxItem Content="Weekly" />
                        </ComboBox>
                    </controls:SettingsRow>

                    <controls:SettingsRow x:Name="BackupFolderRow" Title="Where they go" Symbol="folder">
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="Choose…" Click="OnBackupFolderClick"
                                AutomationProperties.Name="Choose the backup folder" />
                    </controls:SettingsRow>

                    <controls:SettingsRow x:Name="BackupNowRow" Title="Back up now" Symbol="save">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource Button.Secondary}"
                                    Content="Restore…" Click="OnRestoreClick"
                                    AutomationProperties.Name="Restore from a backup" />
                            <Button Style="{StaticResource Button.Primary}"
                                    Content="Back up" Click="OnBackupNowClick"
                                    AutomationProperties.Name="Back up now" />
                        </StackPanel>
                    </controls:SettingsRow>
                </StackPanel>
            </controls:SettingsSection>

            <controls:SettingsSection
                Header="SECURITY"
                Footer="Locking clears every key from memory. Files on disk stay unreadable until the next unlock.">
                <StackPanel>
                    <controls:SettingsRow
                        x:Name="HelloRow"
                        Title="Windows Hello"
                        Subtitle="Checking..."
                        Symbol="shield"
                        ShowSeparator="False">
                        <Button x:Name="HelloButton" Style="{StaticResource Button.Secondary}"
                                Content="Set up" Click="OnHelloClick" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Lock automatically"
                        Subtitle="After this much time with no activity"
                        Symbol="timer">
                        <ComboBox x:Name="AutoLockChoice" MinWidth="150"
                                  SelectionChanged="OnAutoLockChanged"
                                  AutomationProperties.Name="Lock automatically">
                            <ComboBoxItem Content="Never" Tag="0" />
                            <ComboBoxItem Content="After 5 minutes" Tag="5" />
                            <ComboBoxItem Content="After 10 minutes" Tag="10" />
                            <ComboBoxItem Content="After 30 minutes" Tag="30" />
                        </ComboBox>
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Lock now"
                        Subtitle="Ctrl+Shift+L"
                        Symbol="lock">
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="Lock" Click="OnLockNowClick" />
                    </controls:SettingsRow>
                </StackPanel>
            </controls:SettingsSection>

            <controls:SettingsSection
                Header="EMOJI"
                Footer="Campus draws emoji from an artwork pack, never from the Windows emoji font. Build a pack from a colour emoji font you own with tools/emoji/build_pack.py, then drop the folder into the packs directory.">
                <StackPanel>
                    <controls:SettingsRow
                        x:Name="EmojiPackRow"
                        Title="Artwork"
                        Subtitle="Checking..."
                        Symbol="emoji"
                        ShowSeparator="False">
                        <ComboBox x:Name="EmojiPackChoice" MinWidth="180"
                                  SelectionChanged="OnEmojiPackChanged"
                                  AutomationProperties.Name="Emoji artwork pack" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Packs folder"
                        Subtitle="Put a pack here and Campus finds it"
                        Symbol="folder">
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="Open" Click="OnOpenPacksFolderClick" />
                    </controls:SettingsRow>
                </StackPanel>
            </controls:SettingsSection>

            <controls:SettingsSection
                Header="ON THIS PC"
                Footer="Only the small background helper runs at sign-in, never the window. It holds no keys and cannot open your workspace — the most it does is catch a shortcut and watch one folder.">
                <StackPanel>
                    <controls:SettingsRow
                        x:Name="StartupRow"
                        Title="Run the helper at sign-in"
                        Subtitle="Keeps Ctrl+Alt+N working when Campus is closed"
                        Symbol="device.laptop"
                        ShowSeparator="False">
                        <ToggleSwitch x:Name="StartupToggle" OnContent="" OffContent=""
                                      Toggled="OnStartupToggled"
                                      AutomationProperties.Name="Run at sign-in" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        x:Name="DropFolderRow"
                        Title="Drop folder"
                        Subtitle="Anything put here lands in Campus"
                        Symbol="folder">
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="Open" Click="OnOpenDropFolderClick"
                                AutomationProperties.Name="Open the drop folder" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        x:Name="FileTypeRow"
                        Title="Open .campus files with Campus"
                        Subtitle="Gives them the right icon in Explorer"
                        Symbol="file">
                        <Button x:Name="FileTypeButton" Style="{StaticResource Button.Secondary}"
                                Content="Register" Click="OnRegisterFileTypeClick"
                                AutomationProperties.Name="Register the .campus file type" />
                    </controls:SettingsRow>

                    <controls:SettingsRow
                        Title="Shortcuts"
                        Subtitle="On the desktop and in the Start menu"
                        Symbol="add">
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="Create" Click="OnCreateShortcutsClick"
                                AutomationProperties.Name="Create shortcuts" />
                    </controls:SettingsRow>
                </StackPanel>
            </controls:SettingsSection>

            <controls:SettingsSection Header="ABOUT">
                <StackPanel>
                    <controls:SettingsRow Title="Campus" Subtitle="Personal Academic Workspace"
                                          ShowSeparator="False">
                        <TextBlock x:Name="VersionText" Style="{StaticResource Text.Footnote}" />
                    </controls:SettingsRow>
                    <controls:SettingsRow Title="Vault location"
                                          Symbol="folder">
                        <TextBlock x:Name="VaultPathText" Style="{StaticResource Text.Footnote}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    </controls:SettingsRow>
                </StackPanel>
            </controls:SettingsSection>

        </StackPanel>
    </ScrollViewer>
</Page>
