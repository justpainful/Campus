<Page
    x:Class="Campus.Desktop.Views.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Campus.Desktop.Design.Controls"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    Background="{ThemeResource Theme.Background.Primary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="28,18,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource Button.Icon}" Click="OnBackClick"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
                <icons:CampusIcon Symbol="chevron.left" IconSize="{StaticResource Theme.Icon.L}"
                                  Foreground="{ThemeResource Theme.Label.Secondary}" />
            </Button>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title1}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Footnote}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox x:Name="FilterBox" Style="{StaticResource Input.Search}"
                         PlaceholderText="Search threads" Width="200"
                         TextChanged="OnFilterChanged"
                         AutomationProperties.Name="Search threads" />
                <Button Style="{StaticResource Button.Primary}" Click="OnNewThreadClick" MinWidth="0">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <icons:CampusIcon Symbol="add" IconSize="{StaticResource Theme.Icon.M}"
                                          Foreground="{ThemeResource Theme.Label.OnAccent}" />
                        <TextBlock Text="New thread" Foreground="{ThemeResource Theme.Label.OnAccent}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <controls:SegmentedControl x:Name="Segments" Grid.Row="1"
                                   Margin="28,0,28,12" HorizontalAlignment="Left"
                                   SelectionChanged="OnSegmentChanged" />

        <Grid Grid.Row="2">
            <ScrollViewer Padding="28,0,28,40">
                <StackPanel x:Name="List" Spacing="8" MaxWidth="880"
                            HorizontalAlignment="Left" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <icons:CampusIcon Symbol="thread" IconSize="{StaticResource Theme.Icon.Display}"
                                  Weight="Light" Foreground="{ThemeResource Theme.Label.Tertiary}"
                                  HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource Text.Callout}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Text="No threads here yet. Start one with the question you actually have." />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
