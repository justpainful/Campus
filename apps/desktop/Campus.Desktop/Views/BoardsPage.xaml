<Page
    x:Class="Campus.Desktop.Views.BoardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    Background="{ThemeResource Theme.Background.Primary}">

    <!--
        Boards are where a subject's questions live: one thread per question, answered over time.
        Modelled on a forum rather than a chat because a question asked in October should still be
        findable in May, and a chat log is the worst possible shape for that.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="28,20,28,14" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Boards" Style="{StaticResource Text.LargeTitle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Footnote}" />
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Click="OnNewClick"
                    MinWidth="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <icons:CampusIcon Symbol="add" IconSize="{StaticResource Theme.Icon.M}"
                                      Foreground="{ThemeResource Theme.Label.OnAccent}" />
                    <TextBlock Text="New board" Foreground="{ThemeResource Theme.Label.OnAccent}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer Padding="28,0,28,40">
                <StackPanel x:Name="List" Spacing="10" MaxWidth="820"
                            HorizontalAlignment="Left" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                <Border Width="64" Height="64" HorizontalAlignment="Center"
                        CornerRadius="{StaticResource Theme.Radius.Surface}"
                        Background="{ThemeResource Theme.Fill.Quaternary}">
                    <icons:CampusIcon Symbol="boards" IconSize="{StaticResource Theme.Icon.Display}"
                                      Weight="Light" Foreground="{ThemeResource Theme.Label.Tertiary}" />
                </Border>
                <TextBlock Text="No boards yet" Style="{StaticResource Text.Title3}"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Callout}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Text="A board holds threads: one per question, kept until it is answered. Good for the things a subject keeps raising." />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
