<Page
    x:Class="Campus.Desktop.Views.CollectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Campus.Desktop.Design.Controls"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    xmlns:vm="using:Campus.Desktop.ViewModels"
    xmlns:local="using:Campus.Desktop.Views"
    Background="{ThemeResource Theme.Background.Primary}">

    <Page.Resources>
        <!--
            One row. The leading control is a checkbox for the kinds that can be finished and an
            icon for the kinds that cannot, so completing something is always one click away
            where it makes sense and never present where it does not.
        -->
        <DataTemplate x:Key="ObjectRowTemplate" x:DataType="vm:ObjectItem">
            <Grid Padding="4,0,4,0" ColumnSpacing="12" MinHeight="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center" Width="26">
                    <CheckBox
                        x:Name="DoneBox"
                        MinWidth="0"
                        Padding="0"
                        IsChecked="{x:Bind IsDone, Mode=OneWay}"
                        Click="OnCompletionToggled"
                        Visibility="{x:Bind local:CollectionPage.CompletableVisibility(Model.Kind)}"
                        AutomationProperties.Name="Mark complete" />
                    <icons:CampusIcon
                        Symbol="{x:Bind Symbol, Mode=OneWay}"
                        IconSize="{StaticResource Theme.Icon.XL}"
                        Foreground="{ThemeResource Theme.Label.Secondary}"
                        Visibility="{x:Bind local:CollectionPage.IconVisibility(Model.Kind)}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Text="{x:Bind Title, Mode=OneWay}"
                        FontFamily="{StaticResource Theme.Font.Text}"
                        FontSize="{StaticResource Theme.Text.Body}"
                        Foreground="{ThemeResource Theme.Label.Primary}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        Text="{x:Bind Subtitle, Mode=OneWay}"
                        Style="{StaticResource Text.Footnote}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        Visibility="{x:Bind local:CollectionPage.TextVisibility(Subtitle), Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <icons:CampusIcon
                        Symbol="pin"
                        Variant="Filled"
                        IconSize="{StaticResource Theme.Icon.S}"
                        Foreground="{ThemeResource Theme.Label.Tertiary}"
                        Visibility="{x:Bind local:CollectionPage.FlagVisibility(IsPinned), Mode=OneWay}" />
                    <icons:CampusIcon
                        Symbol="star"
                        Variant="Filled"
                        IconSize="{StaticResource Theme.Icon.S}"
                        Foreground="{ThemeResource Theme.Warning.Primary}"
                        Visibility="{x:Bind local:CollectionPage.FlagVisibility(IsFavorite), Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind DueText, Mode=OneWay}"
                        FontFamily="{StaticResource Theme.Font.Small}"
                        FontSize="{StaticResource Theme.Text.Footnote}"
                        Foreground="{x:Bind local:CollectionPage.RoleBrush(DueRole), Mode=OneWay}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind local:CollectionPage.TextVisibility(DueText), Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="28,20,28,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.LargeTitle}" />
                <Border
                    Background="{ThemeResource Theme.Fill.Quaternary}"
                    CornerRadius="{StaticResource Theme.Radius.Pill}"
                    Padding="9,2,9,2"
                    VerticalAlignment="Center"
                    Margin="0,6,0,0">
                    <TextBlock x:Name="CountText" Style="{StaticResource Text.Footnote}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox
                    x:Name="FilterBox"
                    Style="{StaticResource Input.Search}"
                    PlaceholderText="Filter"
                    Width="200"
                    TextChanged="OnFilterChanged"
                    AutomationProperties.Name="Filter this list" />
                <Button
                    x:Name="NewButton"
                    Style="{StaticResource Button.Primary}"
                    Click="OnNewClick"
                    MinWidth="0">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <icons:CampusIcon Symbol="add" IconSize="{StaticResource Theme.Icon.M}"
                                          Foreground="{ThemeResource Theme.Label.OnAccent}" />
                        <TextBlock x:Name="NewLabel" Foreground="{ThemeResource Theme.Label.OnAccent}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <controls:SegmentedControl
            x:Name="Segments"
            Grid.Row="1"
            Margin="28,0,28,12"
            HorizontalAlignment="Left"
            SelectionChanged="OnSegmentChanged" />

        <Grid Grid.Row="2">
            <ListView
                x:Name="Items"
                Padding="20,0,20,24"
                SelectionMode="Extended"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick"
                ItemTemplate="{StaticResource ObjectRowTemplate}"
                AutomationProperties.Name="Items">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,0,8,0" />
                        <Setter Property="MinHeight" Value="52" />
                        <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.M}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Empty state, shown in place of the list rather than above it. -->
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                MaxWidth="380"
                Visibility="Collapsed">
                <Border
                    Width="64" Height="64"
                    HorizontalAlignment="Center"
                    CornerRadius="{StaticResource Theme.Radius.Surface}"
                    Background="{ThemeResource Theme.Fill.Quaternary}">
                    <icons:CampusIcon
                        x:Name="EmptyGlyph"
                        IconSize="{StaticResource Theme.Icon.Display}"
                        Weight="Light"
                        Foreground="{ThemeResource Theme.Label.Tertiary}" />
                </Border>
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource Text.Title3}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock x:Name="EmptyMessage" Style="{StaticResource Text.Callout}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
