<Page
    x:Class="Campus.Desktop.Views.GoalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    Background="{ThemeResource Theme.Background.Primary}">

    <!--
        Goals are the long things — a grade, a habit, a book finished by March. They are kept
        apart from tasks on purpose: a task is done or not, a goal is somewhere in between, and
        showing progress is the whole point of tracking one.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="28,20,28,14" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Goals" Style="{StaticResource Text.LargeTitle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Footnote}" />
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Click="OnNewClick"
                    MinWidth="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <icons:CampusIcon Symbol="add" IconSize="{StaticResource Theme.Icon.M}"
                                      Foreground="{ThemeResource Theme.Label.OnAccent}" />
                    <TextBlock Text="New goal" Foreground="{ThemeResource Theme.Label.OnAccent}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer Padding="28,0,28,40">
                <StackPanel x:Name="List" Spacing="14" MaxWidth="820"
                            HorizontalAlignment="Left" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <Border Width="64" Height="64" HorizontalAlignment="Center"
                        CornerRadius="{StaticResource Theme.Radius.Surface}"
                        Background="{ThemeResource Theme.Fill.Quaternary}">
                    <icons:CampusIcon Symbol="goals" IconSize="{StaticResource Theme.Icon.Display}"
                                      Weight="Light" Foreground="{ThemeResource Theme.Label.Tertiary}" />
                </Border>
                <TextBlock Text="No goals set" Style="{StaticResource Text.Title3}"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Callout}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Text="A goal is bigger than a task and slower than a deadline: finish the textbook, stop leaving revision to the night before." />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
