<Page
    x:Class="Campus.Desktop.Views.ObjectDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Campus.Desktop.Localization"
    xmlns:controls="using:Campus.Desktop.Design.Controls"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    xmlns:local="using:Campus.Desktop.Views"
    Background="{ThemeResource Theme.GroupedBackground.Primary}">

    <!--
        One object, open. Everything on this page is editable in place and saves as you type —
        there is no Save button, because an app you use during a lesson should not need one.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Padding="20,12,20,12" Background="{ThemeResource Theme.GroupedBackground.Primary}">
            <Border VerticalAlignment="Bottom" Height="1"
                    Background="{ThemeResource Theme.Separator.Standard}" />

            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Icon}" Click="OnBackClick"
                        AutomationProperties.Name="{l:T Key=back}"
                        ToolTipService.ToolTip="{l:T Key=back}">
                    <icons:CampusIcon Symbol="chevron.left" IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
                <icons:CampusIcon x:Name="KindIcon" IconSize="{StaticResource Theme.Icon.L}"
                                  Foreground="{ThemeResource Theme.Label.Tertiary}"
                                  Margin="6,0,0,0" />
                <TextBlock x:Name="KindLabel" Style="{StaticResource Text.Footnote}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock x:Name="SavedHint" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button x:Name="FavoriteButton" Style="{StaticResource Button.Icon}"
                        Click="OnFavoriteClick" AutomationProperties.Name="{l:T Key=favourite}">
                    <icons:CampusIcon x:Name="FavoriteIcon" Symbol="star"
                                      IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
                <Button x:Name="PinButton" Style="{StaticResource Button.Icon}"
                        Click="OnPinClick" AutomationProperties.Name="{l:T Key=pin}">
                    <icons:CampusIcon x:Name="PinIcon" Symbol="pin"
                                      IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}" Click="OnDeleteClick"
                        AutomationProperties.Name="{l:T Key=move.to.trash}"
                        ToolTipService.ToolTip="{l:T Key=move.to.trash}">
                    <icons:CampusIcon Symbol="trash" IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="0,0,0,48">
            <StackPanel MaxWidth="760" Margin="24,20,24,0" HorizontalAlignment="Stretch">

                <!-- Title, edited in place -->
                <TextBox
                    x:Name="TitleBox"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12,4,12,4"
                    Margin="0,0,0,4"
                    FontFamily="{StaticResource Theme.Font.Display}"
                    FontSize="{StaticResource Theme.Text.Title1}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource Theme.Label.Primary}"
                    AcceptsReturn="False"
                    TextWrapping="Wrap"
                    PlaceholderText="{l:T Key=untitled}"
                    TextChanged="OnFieldChanged"
                    AutomationProperties.Name="{l:T Key=title}" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,20">
                    <Ellipse x:Name="SubjectDot" Width="9" Height="9" VerticalAlignment="Center" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Callout}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- The fields every kind has -->
                <controls:SettingsSection Header="{l:T Key=details}">
                    <StackPanel>
                        <controls:SettingsRow Title="{l:T Key=status}" Symbol="tasks" ShowSeparator="False">
                            <ComboBox x:Name="StatusChoice" MinWidth="170"
                                      SelectionChanged="OnFieldChanged"
                                      AutomationProperties.Name="{l:T Key=status}">
                                <ComboBoxItem Content="{l:T Key=not.started}" Tag="1" />
                                <ComboBoxItem Content="{l:T Key=in.progress}" Tag="2" />
                                <ComboBoxItem Content="{l:T Key=completed}" Tag="3" />
                                <ComboBoxItem Content="{l:T Key=blocked}" Tag="4" />
                                <ComboBoxItem Content="{l:T Key=waiting}" Tag="5" />
                            </ComboBox>
                        </controls:SettingsRow>

                        <controls:SettingsRow Title="{l:T Key=subject}" Symbol="subjects">
                            <ComboBox x:Name="SubjectChoice" MinWidth="170"
                                      SelectionChanged="OnFieldChanged"
                                      AutomationProperties.Name="{l:T Key=subject}" />
                        </controls:SettingsRow>

                        <controls:SettingsRow Title="{l:T Key=due}" Symbol="calendar">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CalendarDatePicker x:Name="DuePicker" MinWidth="170"
                                                    PlaceholderText="{l:T Key=no.date}"
                                                    DateChanged="OnDueChanged"
                                                    AutomationProperties.Name="{l:T Key=due.date}" />
                                <Button x:Name="ClearDueButton" Style="{StaticResource Button.Icon}"
                                        Click="OnClearDueClick" Visibility="Collapsed"
                                        AutomationProperties.Name="{l:T Key=clear.due.date}">
                                    <icons:CampusIcon Symbol="close" IconSize="{StaticResource Theme.Icon.S}"
                                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsRow>

                        <controls:SettingsRow Title="{l:T Key=priority}" Symbol="flag">
                            <ComboBox x:Name="PriorityChoice" MinWidth="170"
                                      SelectionChanged="OnFieldChanged"
                                      AutomationProperties.Name="{l:T Key=priority}">
                                <ComboBoxItem Content="{l:T Key=none}" Tag="0" />
                                <ComboBoxItem Content="{l:T Key=low}" Tag="1" />
                                <ComboBoxItem Content="{l:T Key=normal}" Tag="2" />
                                <ComboBoxItem Content="{l:T Key=high}" Tag="3" />
                                <ComboBoxItem Content="{l:T Key=urgent}" Tag="4" />
                            </ComboBox>
                        </controls:SettingsRow>
                    </StackPanel>
                </controls:SettingsSection>

                <!-- Fields that only some kinds have. Built in code, because which ones appear
                     depends on what this object is. -->
                <controls:SettingsSection x:Name="KindSection" Header="" Visibility="Collapsed">
                    <StackPanel x:Name="KindFields" />
                </controls:SettingsSection>

                <!-- Body -->
                <StackPanel x:Name="BodySection" Spacing="8" Margin="0,0,0,24">
                    <Grid Margin="16,0,0,0">
                        <TextBlock x:Name="BodyHeader" Text="{l:T Key=notes}"
                                   Style="{StaticResource Text.SectionHeader}"
                                   VerticalAlignment="Center" />
                        <StackPanel x:Name="BodyToolbar" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,0,8,0" />
                    </Grid>
                    <Border Background="{ThemeResource Theme.GroupedBackground.Secondary}"
                            CornerRadius="{StaticResource Theme.Radius.Section}"
                            Padding="6">
                        <TextBox
                            x:Name="BodyBox"
                            Background="Transparent"
                            BorderThickness="0"
                            MinHeight="150"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            PlaceholderText="{l:T Key=anything.worth.remembering}"
                            TextChanged="OnFieldChanged"
                            AutomationProperties.Name="{l:T Key=notes.8a75}" />
                    </Border>
                </StackPanel>

                <!-- Checklist -->
                <StackPanel x:Name="ChecklistSection" Spacing="8" Margin="0,0,0,24"
                            Visibility="Collapsed">
                    <TextBlock Text="{l:T Key=checklist}" Style="{StaticResource Text.SectionHeader}"
                               Margin="16,0,0,0" />
                    <Border Background="{ThemeResource Theme.GroupedBackground.Secondary}"
                            CornerRadius="{StaticResource Theme.Radius.Section}"
                            Padding="8">
                        <StackPanel>
                            <StackPanel x:Name="ChecklistItems" />
                            <Grid ColumnSpacing="8" Margin="8,6,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewChecklistBox"
                                         Style="{StaticResource Input.Text}"
                                         PlaceholderText="{l:T Key=add.a.step}"
                                         KeyDown="OnNewChecklistKeyDown"
                                         AutomationProperties.Name="{l:T Key=add.a.checklist.step}" />
                                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}"
                                        Content="{l:T Key=add}" Click="OnAddChecklistClick" MinWidth="0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tags -->
                <StackPanel Spacing="8" Margin="0,0,0,24">
                    <TextBlock Text="{l:T Key=tags}" Style="{StaticResource Text.SectionHeader}"
                               Margin="16,0,0,0" />
                    <Border Background="{ThemeResource Theme.GroupedBackground.Secondary}"
                            CornerRadius="{StaticResource Theme.Radius.Section}"
                            Padding="12">
                        <StackPanel Spacing="10">
                            <controls:WrapPanel x:Name="TagList" ItemSpacing="6" LineSpacing="6" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewTagBox" Style="{StaticResource Input.Text}"
                                         PlaceholderText="{l:T Key=add.a.tag}"
                                         KeyDown="OnNewTagKeyDown"
                                         AutomationProperties.Name="{l:T Key=add.a.tag}" />
                                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}"
                                        Content="{l:T Key=add}" Click="OnAddTagClick" MinWidth="0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--
                    Links, in both directions. A backlink is the same row read the other way
                    round, so nothing here can go stale on one side only.
                -->
                <StackPanel Spacing="8" Margin="0,0,0,24">
                    <TextBlock Text="{l:T Key=links}" Style="{StaticResource Text.SectionHeader}"
                               Margin="16,0,0,0" />
                    <Border Background="{ThemeResource Theme.GroupedBackground.Secondary}"
                            CornerRadius="{StaticResource Theme.Radius.Section}"
                            Padding="12">
                        <StackPanel Spacing="10">
                            <StackPanel x:Name="LinkList" Spacing="2" />
                            <Button Style="{StaticResource Button.Secondary}"
                                    Content="{l:T Key=link.to.something}" Click="OnAddLinkClick"
                                    MinWidth="0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--
                    Earlier text, kept for the kinds that can be overwritten. Restoring snapshots
                    the current text first, so it is itself undoable.
                -->
                <StackPanel x:Name="VersionSection" Spacing="8" Margin="0,0,0,24"
                            Visibility="Collapsed">
                    <TextBlock Text="{l:T Key=earlier.versions}" Style="{StaticResource Text.SectionHeader}"
                               Margin="16,0,0,0" />
                    <Border Background="{ThemeResource Theme.GroupedBackground.Secondary}"
                            CornerRadius="{StaticResource Theme.Radius.Section}"
                            Padding="12">
                        <StackPanel x:Name="VersionList" Spacing="2" />
                    </Border>
                </StackPanel>

                <!-- History -->
                <controls:SettingsSection Header="{l:T Key=history}"
                                          Footer="{l:T Key=every.change.is.recorded.including.the.ones.ma.db13d3}">
                    <StackPanel x:Name="HistoryList" Padding="16" Spacing="8" />
                </controls:SettingsSection>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
