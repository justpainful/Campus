<Page
    x:Class="Campus.Desktop.Views.ObjectDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Campus.Desktop.Design.Controls"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    xmlns:local="using:Campus.Desktop.Views"
    Background="{ThemeResource Theme.GroupedBackground.Primary}">

    <!--
        One object, open. Everything on this page is editable in place and saves as you type —
        there is no Save button, because an app you use during a lesson should not need one.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Padding="20,12,20,12" Background="{ThemeResource Theme.GroupedBackground.Primary}">
            <Border VerticalAlignment="Bottom" Height="1"
                    Background="{ThemeResource Theme.Separator.Standard}" />

            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Icon}" Click="OnBackClick"
                        AutomationProperties.Name="Back"
                        ToolTipService.ToolTip="Back">
                    <icons:CampusIcon Symbol="chevron.left" IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
                <icons:CampusIcon x:Name="KindIcon" IconSize="{StaticResource Theme.Icon.L}"
                                  Foreground="{ThemeResource Theme.Label.Tertiary}"
                                  Margin="6,0,0,0" />
                <TextBlock x:Name="KindLabel" Style="{StaticResource Text.Footnote}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock x:Name="SavedHint" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button x:Name="FavoriteButton" Style="{StaticResource Button.Icon}"
                        Click="OnFavoriteClick" AutomationProperties.Name="Favourite">
                    <icons:CampusIcon x:Name="FavoriteIcon" Symbol="star"
                                      IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
                <Button x:Name="PinButton" Style="{StaticResource Button.Icon}"
                        Click="OnPinClick" AutomationProperties.Name="Pin">
                    <icons:CampusIcon x:Name="PinIcon" Symbol="pin"
                                      IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}" Click="OnDeleteClick"
                        AutomationProperties.Name="Move to trash"
                        ToolTipService.ToolTip="Move to trash">
                    <icons:CampusIcon Symbol="trash" IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="0,0,0,48">
            <StackPanel MaxWidth="760" Margin="24,20,24,0" HorizontalAlignment="Stretch">

                <!-- Title, edited in place -->
                <TextBox
                    x:Name="TitleBox"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12,4,12,4"
                    Margin="0,0,0,4"
                    FontFamily="{StaticResource Theme.Font.Display}"
                    FontSize="{StaticResource Theme.Text.Title1}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource Theme.Label.Primary}"
                    AcceptsReturn="False"
                    TextWrapping="Wrap"
                    PlaceholderText="Untitled"
                    TextChanged="OnFieldChanged"
                    AutomationProperties.Name="Title" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,20">
                    <Ellipse x:Name="SubjectDot" Width="9" Height="9" VerticalAlignment="Center" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Callout}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- The fields every kind has -->
                <controls:SettingsSection Header="DETAILS">
                    <StackPanel>
                        <controls:SettingsRow Title="Status" Symbol="tasks" ShowSeparator="False">
                            <ComboBox x:Name="StatusChoice" MinWidth="170"
                                      SelectionChanged="OnFieldChanged"
                                      AutomationProperties.Name="Status">
                                <ComboBoxItem Content="Not started" Tag="1" />
                                <ComboBoxItem Content="In progress" Tag="2" />
                                <ComboBoxItem Content="Completed" Tag="3" />
                                <ComboBoxItem Content="Blocked" Tag="4" />
                                <ComboBoxItem Content="Waiting" Tag="5" />
                            </ComboBox>
                        </controls:SettingsRow>

                        <controls:SettingsRow Title="Subject" Symbol="subjects">
                            <ComboBox x:Name="SubjectChoice" MinWidth="170"
                                      SelectionChanged="OnFieldChanged"
                                      AutomationProperties.Name="Subject" />
                        </controls:SettingsRow>

                        <controls:SettingsRow Title="Due" Symbol="calendar">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CalendarDatePicker x:Name="DuePicker" MinWidth="170"
                                                    PlaceholderText="No date"
                                                    DateChanged="OnDueChanged"
                                                    AutomationProperties.Name="Due date" />
                                <Button x:Name="ClearDueButton" Style="{StaticResource Button.Icon}"
                                        Click="OnClearDueClick" Visibility="Collapsed"
                                        AutomationProperties.Name="Clear due date">
                                    <icons:CampusIcon Symbol="close" IconSize="{StaticResource Theme.Icon.S}"
                                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsRow>

                        <controls:SettingsRow Title="Priority" Symbol="flag">
                            <ComboBox x:Name="PriorityChoice" MinWidth="170"
                                      SelectionChanged="OnFieldChanged"
                                      AutomationProperties.Name="Priority">
                                <ComboBoxItem Content="None" Tag="0" />
                                <ComboBoxItem Content="Low" Tag="1" />
                                <ComboBoxItem Content="Normal" Tag="2" />
                                <ComboBoxItem Content="High" Tag="3" />
                                <ComboBoxItem Content="Urgent" Tag="4" />
                            </ComboBox>
                        </controls:SettingsRow>
                    </StackPanel>
                </controls:SettingsSection>

                <!-- Fields that only some kinds have. Built in code, because which ones appear
                     depends on what this object is. -->
                <controls:SettingsSection x:Name="KindSection" Header="" Visibility="Collapsed">
                    <StackPanel x:Name="KindFields" />
                </controls:SettingsSection>

                <!-- Body -->
                <StackPanel x:Name="BodySection" Spacing="8" Margin="0,0,0,24">
                    <Grid Margin="16,0,0,0">
                        <TextBlock x:Name="BodyHeader" Text="NOTES"
                                   Style="{StaticResource Text.SectionHeader}"
                                   VerticalAlignment="Center" />
                        <StackPanel x:Name="BodyToolbar" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,0,8,0" />
                    </Grid>
                    <Border Background="{ThemeResource Theme.GroupedBackground.Secondary}"
                            CornerRadius="{StaticResource Theme.Radius.Section}"
                            Padding="6">
                        <TextBox
                            x:Name="BodyBox"
                            Background="Transparent"
                            BorderThickness="0"
                            MinHeight="150"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            PlaceholderText="Anything worth remembering"
                            TextChanged="OnFieldChanged"
                            AutomationProperties.Name="Notes" />
                    </Border>
                </StackPanel>

                <!-- Checklist -->
                <StackPanel x:Name="ChecklistSection" Spacing="8" Margin="0,0,0,24"
                            Visibility="Collapsed">
                    <TextBlock Text="CHECKLIST" Style="{StaticResource Text.SectionHeader}"
                               Margin="16,0,0,0" />
                    <Border Background="{ThemeResource Theme.GroupedBackground.Secondary}"
                            CornerRadius="{StaticResource Theme.Radius.Section}"
                            Padding="8">
                        <StackPanel>
                            <StackPanel x:Name="ChecklistItems" />
                            <Grid ColumnSpacing="8" Margin="8,6,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewChecklistBox"
                                         Style="{StaticResource Input.Text}"
                                         PlaceholderText="Add a step"
                                         KeyDown="OnNewChecklistKeyDown"
                                         AutomationProperties.Name="Add a checklist step" />
                                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}"
                                        Content="Add" Click="OnAddChecklistClick" MinWidth="0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tags -->
                <StackPanel Spacing="8" Margin="0,0,0,24">
                    <TextBlock Text="TAGS" Style="{StaticResource Text.SectionHeader}"
                               Margin="16,0,0,0" />
                    <Border Background="{ThemeResource Theme.GroupedBackground.Secondary}"
                            CornerRadius="{StaticResource Theme.Radius.Section}"
                            Padding="12">
                        <StackPanel Spacing="10">
                            <controls:WrapPanel x:Name="TagList" ItemSpacing="6" LineSpacing="6" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewTagBox" Style="{StaticResource Input.Text}"
                                         PlaceholderText="Add a tag"
                                         KeyDown="OnNewTagKeyDown"
                                         AutomationProperties.Name="Add a tag" />
                                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}"
                                        Content="Add" Click="OnAddTagClick" MinWidth="0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- History -->
                <controls:SettingsSection Header="HISTORY"
                                          Footer="Every change is recorded, including the ones made on another device.">
                    <StackPanel x:Name="HistoryList" Padding="16" Spacing="8" />
                </controls:SettingsSection>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
