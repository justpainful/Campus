<Page
    x:Class="Campus.Desktop.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Campus.Desktop.Design.Controls"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    Background="{ThemeResource Theme.GroupedBackground.Primary}">

    <!--
        Who the workspace belongs to, academically: the year, the term, the school. Campus uses
        these to decide what "this term" means everywhere else, so they are worth asking for once
        rather than guessing.
    -->
    <ScrollViewer>
        <StackPanel Padding="28,24,28,48" Spacing="24" MaxWidth="720" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Profile" Style="{StaticResource Text.LargeTitle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Footnote}" />
            </StackPanel>

            <controls:SettingsSection x:Name="WhoSection" Header="WHO" />
            <controls:SettingsSection x:Name="YearSection" Header="ACADEMIC YEAR" />

            <StackPanel Spacing="10">
                <TextBlock Text="HOW I STUDY" Style="{StaticResource Text.SectionHeader}" />
                <Border Style="{StaticResource Surface.Section}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource Text.Footnote}" TextWrapping="Wrap"
                                   Text="Rules you have set for yourself. Campus does not enforce them — it keeps them where you will see them." />
                        <StackPanel x:Name="RulesList" Spacing="6" />
                        <Button Style="{StaticResource Button.Secondary}" Click="OnAddRuleClick"
                                Content="Add a rule" MinWidth="0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="THIS WORKSPACE" Style="{StaticResource Text.SectionHeader}" />
                <Border Style="{StaticResource Surface.Section}" Padding="16">
                    <controls:WrapPanel x:Name="Stats" ItemSpacing="28" LineSpacing="18" />
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
