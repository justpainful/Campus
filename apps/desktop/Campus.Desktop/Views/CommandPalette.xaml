<UserControl
    x:Class="Campus.Desktop.Views.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Campus.Desktop.Localization"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    xmlns:local="using:Campus.Desktop.Views"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!--
        The palette. One overlay serves both modes: typing plain text searches commands, and a
        leading space or Ctrl+P searches the workspace instead. Dismissing is Escape or a click
        on the scrim, and nothing behind it is reachable while it is open.
    -->
    <Grid x:Name="Root" Visibility="Collapsed">
        <Rectangle
            Fill="{ThemeResource Theme.Scrim}"
            PointerPressed="OnScrimPressed" />

        <Border
            Width="620"
            MaxHeight="440"
            VerticalAlignment="Top"
            Margin="0,90,0,0"
            Background="{ThemeResource Theme.Surface.Elevated}"
            CornerRadius="{StaticResource Theme.Radius.Dialog}"
            BorderThickness="1"
            BorderBrush="{ThemeResource Theme.Separator.Standard}">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="14,12,14,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <icons:CampusIcon
                        x:Name="ModeIcon"
                        Symbol="command"
                        IconSize="{StaticResource Theme.Icon.L}"
                        Foreground="{ThemeResource Theme.Label.Tertiary}"
                        VerticalAlignment="Center" />
                    <TextBox
                        x:Name="Input"
                        Grid.Column="1"
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="0"
                        FontSize="{StaticResource Theme.Text.Title3}"
                        PlaceholderText="{l:T Key=type.a.command}"
                        TextChanged="OnQueryChanged"
                        KeyDown="OnInputKeyDown"
                        AutomationProperties.Name="{l:T Key=command.palette}" />
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{ThemeResource Theme.Separator.Standard}" />

                <ListView
                    x:Name="Results"
                    Grid.Row="2"
                    Padding="8"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="OnResultClick"
                    AutomationProperties.Name="{l:T Key=results}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="10,0,10,0" />
                            <Setter Property="MinHeight" Value="44" />
                            <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.S}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PaletteEntry">
                            <Grid ColumnSpacing="12" MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <icons:CampusIcon
                                    Symbol="{x:Bind Symbol}"
                                    IconSize="{StaticResource Theme.Icon.L}"
                                    Foreground="{ThemeResource Theme.Label.Secondary}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        FontFamily="{StaticResource Theme.Font.Text}"
                                        FontSize="{StaticResource Theme.Text.Body}"
                                        Foreground="{ThemeResource Theme.Label.Primary}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Text="{x:Bind Detail}"
                                        Style="{StaticResource Text.Caption}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Visibility="{x:Bind local:CommandPalette.TextVisibility(Detail)}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="2"
                                    Background="{ThemeResource Theme.Fill.Quaternary}"
                                    CornerRadius="{StaticResource Theme.Radius.XS}"
                                    Padding="7,2,7,2"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind local:CommandPalette.TextVisibility(Shortcut)}">
                                    <TextBlock
                                        Text="{x:Bind Shortcut}"
                                        FontFamily="{StaticResource Theme.Font.Small}"
                                        FontSize="{StaticResource Theme.Text.Caption2}"
                                        Foreground="{ThemeResource Theme.Label.Tertiary}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="3" Padding="14,8,14,10">
                    <Border Height="1" VerticalAlignment="Top" Margin="-14,-8,-14,0"
                            Background="{ThemeResource Theme.Separator.Standard}" />
                    <TextBlock
                        x:Name="HintText"
                        Style="{StaticResource Text.Caption}"
                        Text="{l:T Key=enter.to.run.tab.to.switch.to.search.esc.to.cl.2e43d6}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
