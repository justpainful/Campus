<Page
    x:Class="Campus.Desktop.Views.ThreadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Campus.Desktop.Localization"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    Background="{ThemeResource Theme.Background.Primary}">

    <!--
        One question and everything that has been worked out about it since. The composer stays at
        the bottom the way a conversation expects, but the thread itself reads top-down like a
        document, because that is how it will be read again in May.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="28,18,28,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border VerticalAlignment="Bottom" Height="1" Grid.ColumnSpan="3"
                    Background="{ThemeResource Theme.Separator.Standard}" />

            <Button Style="{StaticResource Button.Icon}" Click="OnBackClick"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{l:T Key=back}" ToolTipService.ToolTip="{l:T Key=back}">
                <icons:CampusIcon Symbol="chevron.left" IconSize="{StaticResource Theme.Icon.L}"
                                  Foreground="{ThemeResource Theme.Label.Secondary}" />
            </Button>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title2}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Footnote}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ResolveButton" Style="{StaticResource Button.Secondary}"
                        Click="OnResolveClick" Content="{l:T Key=mark.resolved}" MinWidth="0" />
                <Button Style="{StaticResource Button.Icon}" Click="OnMoreClick"
                        AutomationProperties.Name="{l:T Key=more}" ToolTipService.ToolTip="{l:T Key=more}">
                    <icons:CampusIcon Symbol="more" IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Padding="28,20,28,20">
            <StackPanel x:Name="Posts" Spacing="16" MaxWidth="820" HorizontalAlignment="Left" />
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="28,12,28,20" Background="{ThemeResource Theme.Background.Primary}">
            <Border VerticalAlignment="Top" Height="1"
                    Background="{ThemeResource Theme.Separator.Standard}" />

            <Grid MaxWidth="820" HorizontalAlignment="Left" ColumnSpacing="10" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="Composer" Style="{StaticResource Input.Text}"
                         PlaceholderText="{l:T Key=add.what.you.worked.out}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="44" MaxHeight="180" Width="700"
                         KeyDown="OnComposerKeyDown"
                         AutomationProperties.Name="{l:T Key=write.a.reply}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Bottom">
                    <Button x:Name="EmojiButton" Style="{StaticResource Button.Icon}"
                            AutomationProperties.Name="{l:T Key=emoji}" ToolTipService.ToolTip="{l:T Key=emoji}">
                        <icons:CampusIcon Symbol="emoji" IconSize="{StaticResource Theme.Icon.L}"
                                          Foreground="{ThemeResource Theme.Label.Secondary}" />
                    </Button>
                    <Button Style="{StaticResource Button.Primary}" Click="OnSendClick"
                            Content="{l:T Key=post}" MinWidth="0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
