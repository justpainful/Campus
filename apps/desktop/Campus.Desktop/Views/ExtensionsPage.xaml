<Page
    x:Class="Campus.Desktop.Views.ExtensionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Campus.Desktop.Localization"
    xmlns:controls="using:Campus.Desktop.Design.Controls"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    Background="{ThemeResource Theme.GroupedBackground.Primary}">

    <!--
        Extensions, and what each one is allowed to do. The permissions are listed on the card
        rather than hidden behind a dialog nobody opens twice.
    -->
    <ScrollViewer>
        <StackPanel Padding="28,24,28,48" Spacing="24" MaxWidth="760" HorizontalAlignment="Left">

            <Grid>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{l:T Key=extensions}" Style="{StaticResource Text.LargeTitle}" />
                    <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Footnote}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Secondary}" Click="OnFolderClick"
                            Content="{l:T Key=from.folder}" MinWidth="0" />
                    <Button Style="{StaticResource Button.Primary}" Click="OnInstallClick"
                            Content="{l:T Key=install}" MinWidth="0" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Surface.Section}" Padding="18">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:CampusIcon Symbol="shield" IconSize="20"
                                          Foreground="{ThemeResource Theme.Label.Secondary}"
                                          VerticalAlignment="Center" />
                        <TextBlock Text="{l:T Key=extensions.run.outside.campus}"
                                   Style="{StaticResource Text.Headline}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Footnote}" TextWrapping="Wrap"
                               Text="{l:T Key=each.one.runs.in.a.process.of.its.own.with.no.cccde5}" />
                </StackPanel>
            </Border>

            <controls:SettingsSection x:Name="InstalledSection" Header="{l:T Key=installed}"
                                      Visibility="Collapsed" />

            <controls:SettingsSection x:Name="BuiltInSection" Header="{l:T Key=built.into.campus}"
                                      Footer="{l:T Key=these.are.the.readers.and.tools.campus.ships.w.1dc118}" />

        </StackPanel>
    </ScrollViewer>
</Page>
