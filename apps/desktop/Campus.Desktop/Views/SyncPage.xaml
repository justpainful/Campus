<Page
    x:Class="Campus.Desktop.Views.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Campus.Desktop.Localization"
    xmlns:controls="using:Campus.Desktop.Design.Controls"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    Background="{ThemeResource Theme.GroupedBackground.Primary}">

    <!--
        Sync without a server. Two devices exchange the part of the change log the other has not
        seen — over a cable, a folder, or the local network. Nothing leaves the two machines, and
        nothing announces either of them to anyone.
    -->
    <ScrollViewer>
        <StackPanel Padding="28,24,28,48" Spacing="24" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="{l:T Key=sync}" Style="{StaticResource Text.LargeTitle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Footnote}" />
            </StackPanel>

            <Border Style="{StaticResource Surface.Section}" Padding="18">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:CampusIcon Symbol="cloud.off" IconSize="20"
                                          Foreground="{ThemeResource Theme.Label.Secondary}"
                                          VerticalAlignment="Center" />
                        <TextBlock Text="{l:T Key=no.account.no.server.no.cloud}"
                                   Style="{StaticResource Text.Headline}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Footnote}" TextWrapping="Wrap"
                               Text="{l:T Key=your.devices.exchange.changes.directly.a.bundl.6bc8b4}" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock Text="{l:T Key=devices}" Style="{StaticResource Text.SectionHeader}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="{l:T Key=pair.a.computer}" Click="OnPairClick" MinWidth="0" />
                        <Button Style="{StaticResource Button.Primary}"
                                Content="{l:T Key=pair.a.phone}" Click="OnPairPhoneClick" MinWidth="0" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource Surface.Section}" Padding="4">
                    <StackPanel x:Name="DeviceList" />
                </Border>
            </StackPanel>

            <StackPanel x:Name="ConflictSection" Spacing="10" Visibility="Collapsed">
                <TextBlock Text="{l:T Key=needs.a.decision}" Style="{StaticResource Text.SectionHeader}" />
                <Border Style="{StaticResource Surface.Section}" Padding="4">
                    <StackPanel x:Name="ConflictList" />
                </Border>
                <TextBlock Style="{StaticResource Text.Footnote}" TextWrapping="Wrap"
                           Text="{l:T Key=both.devices.changed.these.since.they.last.agr.bbf001}" />
            </StackPanel>

            <controls:SettingsSection x:Name="TransferSection" Header="{l:T Key=transfer}"
                                      Footer="{l:T Key=a.bundle.is.a.file.put.it.on.a.stick.drop.it.i.9bff13}" />

            <Border x:Name="StatusPanel" Style="{StaticResource Surface.Section}"
                    Padding="16" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing x:Name="StatusRing" IsActive="True" Width="20" Height="20" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Text.Callout}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
