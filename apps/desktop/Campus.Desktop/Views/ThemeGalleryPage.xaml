<Page
    x:Class="Campus.Desktop.Views.ThemeGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Campus.Desktop.Localization"
    xmlns:controls="using:Campus.Desktop.Design.Controls"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    xmlns:brand="using:Campus.Desktop.Design.Brand"
    Background="{ThemeResource Theme.GroupedBackground.Primary}">

    <!--
        The theme in one place. Every role, every state, every component, so the whole system
        can be reviewed at once instead of hunting for a screen that happens to use a token.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sticky header: the appearance switch lives with the thing it changes. -->
        <Grid Padding="24,16,24,16" Background="{ThemeResource Theme.GroupedBackground.Primary}">
            <Border VerticalAlignment="Bottom" Height="1"
                    Background="{ThemeResource Theme.Separator.Standard}" />
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Icon}" Click="OnBackClick"
                        AutomationProperties.Name="{l:T Key=back}">
                    <icons:CampusIcon Symbol="chevron.left" IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
                <TextBlock Text="{l:T Key=theme.gallery.a6cc}" Style="{StaticResource Text.Title2}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <RadioButton x:Name="ModeSystem" Content="{l:T Key=system}" GroupName="GalleryMode"
                             Checked="OnModeChanged" Tag="System" />
                <RadioButton x:Name="ModeLight" Content="{l:T Key=light}" GroupName="GalleryMode"
                             Checked="OnModeChanged" Tag="Light" />
                <RadioButton x:Name="ModeDark" Content="{l:T Key=dark}" GroupName="GalleryMode"
                             Checked="OnModeChanged" Tag="Dark" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="0,0,0,60">
            <StackPanel MaxWidth="860" Margin="24,24,24,0" HorizontalAlignment="Stretch">

                <!-- ================================================== BACKGROUNDS -->
                <controls:SettingsSection
                    Header="{l:T Key=background}"
                    Footer="{l:T Key=canvas.levels.in.dark.these.run.000000.1c1c1e.464e98}">
                    <StackPanel x:Name="BackgroundSwatches" Padding="16" Spacing="10" />
                </controls:SettingsSection>

                <controls:SettingsSection
                    Header="{l:T Key=grouped.background}"
                    Footer="{l:T Key=what.a.settings.style.page.paints.and.what.its.632e47}">
                    <StackPanel x:Name="GroupedSwatches" Padding="16" Spacing="10" />
                </controls:SettingsSection>

                <controls:SettingsSection
                    Header="{l:T Key=surface}"
                    Footer="{l:T Key=raising.an.element.raises.its.surface.depth.co.ebb744}">
                    <StackPanel x:Name="SurfaceSwatches" Padding="16" Spacing="10" />
                </controls:SettingsSection>

                <!-- ======================================================= LABELS -->
                <controls:SettingsSection
                    Header="{l:T Key=label}"
                    Footer="{l:T Key=text.hierarchy.is.real.opacity.not.four.hand.p.a0f9f7}">
                    <StackPanel Padding="16" Spacing="8">
                        <TextBlock Text="{l:T Key=primary.the.thing.you.are.reading}"
                                   Foreground="{ThemeResource Theme.Label.Primary}"
                                   FontSize="{StaticResource Theme.Text.Body}" />
                        <TextBlock Text="{l:T Key=secondary.the.sentence.underneath.it}"
                                   Foreground="{ThemeResource Theme.Label.Secondary}"
                                   FontSize="{StaticResource Theme.Text.Body}" />
                        <TextBlock Text="{l:T Key=tertiary.metadata.and.placeholders}"
                                   Foreground="{ThemeResource Theme.Label.Tertiary}"
                                   FontSize="{StaticResource Theme.Text.Body}" />
                        <TextBlock Text="{l:T Key=quaternary.the.faintest.thing.still.on.screen}"
                                   Foreground="{ThemeResource Theme.Label.Quaternary}"
                                   FontSize="{StaticResource Theme.Text.Body}" />
                    </StackPanel>
                </controls:SettingsSection>

                <!-- ================================================== TYPOGRAPHY -->
                <controls:SettingsSection
                    Header="{l:T Key=typography}"
                    Footer="{l:T Key=large.text.uses.the.display.face.and.reading.s.0d8d97}">
                    <StackPanel Padding="16" Spacing="6">
                        <TextBlock Text="{l:T Key=large.title}" Style="{StaticResource Text.LargeTitle}" />
                        <TextBlock Text="{l:T Key=title.1}" Style="{StaticResource Text.Title1}" />
                        <TextBlock Text="{l:T Key=title.2}" Style="{StaticResource Text.Title2}" />
                        <TextBlock Text="{l:T Key=title.3}" Style="{StaticResource Text.Title3}" />
                        <TextBlock Text="{l:T Key=headline}" Style="{StaticResource Text.Headline}" />
                        <TextBlock Text="{l:T Key=body.the.size.everything.long.is.set.in}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{l:T Key=callout}" Style="{StaticResource Text.Callout}" />
                        <TextBlock Text="{l:T Key=footnote}" Style="{StaticResource Text.Footnote}" />
                        <TextBlock Text="{l:T Key=caption}" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{l:T Key=section.header}" Style="{StaticResource Text.SectionHeader}" />
                    </StackPanel>
                </controls:SettingsSection>

                <!-- ======================================================== FILLS -->
                <controls:SettingsSection
                    Header="{l:T Key=fill}"
                    Footer="{l:T Key=fills.are.for.control.backgrounds.hover.presse.554e21}">
                    <StackPanel x:Name="FillSwatches" Padding="16" Spacing="10" />
                </controls:SettingsSection>

                <!-- =================================================== SEPARATORS -->
                <controls:SettingsSection
                    Header="{l:T Key=separator}"
                    Footer="{l:T Key=drawn.only.where.content.genuinely.abuts.under.03ed85}">
                    <StackPanel Padding="16" Spacing="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{l:T Key=standard}" Style="{StaticResource Text.Footnote}" />
                            <Border Height="1" Background="{ThemeResource Theme.Separator.Standard}" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="{l:T Key=opaque}" Style="{StaticResource Text.Footnote}" />
                            <Border Height="1" Background="{ThemeResource Theme.Separator.Opaque}" />
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsSection>

                <!-- ====================================================== BUTTONS -->
                <controls:SettingsSection
                    Header="{l:T Key=buttons}"
                    Footer="{l:T Key=blue.is.the.primary.action.red.is.only.for.wha.e97216}">
                    <StackPanel Padding="16" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{StaticResource Button.Primary}" Content="{l:T Key=primary}" />
                            <Button Style="{StaticResource Button.Secondary}" Content="{l:T Key=secondary}" />
                            <Button Style="{StaticResource Button.Plain}" Content="{l:T Key=plain}" />
                            <Button Style="{StaticResource Button.Destructive}" Content="{l:T Key=delete}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{StaticResource Button.Primary}" Content="{l:T Key=disabled}" IsEnabled="False" />
                            <Button Style="{StaticResource Button.Secondary}" Content="{l:T Key=disabled}" IsEnabled="False" />
                            <Button Style="{StaticResource Button.Destructive}" Content="{l:T Key=disabled}" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Style="{StaticResource Button.Icon}" AutomationProperties.Name="{l:T Key=add}">
                                <icons:CampusIcon Symbol="add" IconSize="{StaticResource Theme.Icon.XL}" />
                            </Button>
                            <Button Style="{StaticResource Button.Icon}" AutomationProperties.Name="{l:T Key=search}">
                                <icons:CampusIcon Symbol="search" IconSize="{StaticResource Theme.Icon.L}" />
                            </Button>
                            <Button Style="{StaticResource Button.Icon}" AutomationProperties.Name="{l:T Key=star}">
                                <icons:CampusIcon Symbol="star" IconSize="{StaticResource Theme.Icon.L}" />
                            </Button>
                            <Button Style="{StaticResource Button.IconLarge}" AutomationProperties.Name="{l:T Key=print}">
                                <icons:CampusIcon Symbol="print" IconSize="{StaticResource Theme.Icon.XXL}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsSection>

                <!-- ======================================================= INPUTS -->
                <controls:SettingsSection Header="{l:T Key=inputs}">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBox Style="{StaticResource Input.Text}" PlaceholderText="{l:T Key=title}"
                                 AutomationProperties.Name="{l:T Key=title}" />
                        <TextBox Style="{StaticResource Input.Search}" PlaceholderText="{l:T Key=search.everything}"
                                 AutomationProperties.Name="{l:T Key=search}" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <CheckBox Content="{l:T Key=checkbox}" />
                            <CheckBox Content="{l:T Key=checked}" IsChecked="True" />
                            <CheckBox Content="{l:T Key=disabled}" IsEnabled="False" />
                            <ToggleSwitch OnContent="" OffContent="" IsOn="True"
                                          AutomationProperties.Name="{l:T Key=sample.toggle}" />
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsSection>

                <!-- =============================================== SETTINGS ROWS -->
                <controls:SettingsSection
                    Header="{l:T Key=settings.section}"
                    Footer="{l:T Key=one.surface.hairlines.between.rows.not.a.page.6123c3}">
                    <StackPanel>
                        <controls:SettingsRow Title="{l:T Key=wi.fi}" Symbol="wifi" ShowSeparator="False">
                            <ToggleSwitch OnContent="" OffContent="" IsOn="True"
                                          AutomationProperties.Name="{l:T Key=wi.fi}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="{l:T Key=local.network.sync}"
                                              Subtitle="{l:T Key=pair.a.device.to.turn.this.on}"
                                              Symbol="sync">
                            <ToggleSwitch OnContent="" OffContent=""
                                          AutomationProperties.Name="{l:T Key=local.network.sync}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="{l:T Key=delete.workspace}"
                                              Subtitle="{l:T Key=this.cannot.be.undone}"
                                              Symbol="trash"
                                              IsDestructive="True">
                            <icons:CampusIcon Symbol="chevron.right"
                                              IconSize="{StaticResource Theme.Icon.M}"
                                              Foreground="{ThemeResource Theme.Label.Tertiary}" />
                        </controls:SettingsRow>
                    </StackPanel>
                </controls:SettingsSection>

                <!-- ======================================================= STATES -->
                <controls:SettingsSection
                    Header="{l:T Key=semantic.states}"
                    Footer="{l:T Key=meaning.not.decoration.blue.acts.red.destroys.8656c4}">
                    <StackPanel x:Name="StateSwatches" Padding="16" Spacing="10" />
                </controls:SettingsSection>

                <!-- ============================================== SUBJECT ACCENTS -->
                <controls:SettingsSection
                    Header="{l:T Key=subject.accents}"
                    Footer="{l:T Key=a.fixed.calm.set.subjects.store.the.name.never.8d37a8}">
                    <StackPanel x:Name="SubjectSwatches" Padding="16" Spacing="10" />
                </controls:SettingsSection>

                <!-- ======================================================== ICONS -->
                <controls:SettingsSection
                    Header="{l:T Key=icons}"
                    Footer="{l:T Key=drawn.geometry.on.a.24.unit.grid.stroked.at.re.da7c65}">
                    <StackPanel Padding="16" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <icons:CampusIcon Symbol="library" IconSize="12" />
                            <icons:CampusIcon Symbol="library" IconSize="16" />
                            <icons:CampusIcon Symbol="library" IconSize="20" />
                            <icons:CampusIcon Symbol="library" IconSize="24" />
                            <icons:CampusIcon Symbol="library" IconSize="32" />
                            <icons:CampusIcon Symbol="library" IconSize="48" />
                            <TextBlock Text="{l:T Key=one.definition.optically.corrected.per.size}"
                                       Style="{StaticResource Text.Footnote}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <icons:CampusIcon Symbol="tasks" IconSize="28" Weight="Ultralight" />
                            <icons:CampusIcon Symbol="tasks" IconSize="28" Weight="Light" />
                            <icons:CampusIcon Symbol="tasks" IconSize="28" Weight="Regular" />
                            <icons:CampusIcon Symbol="tasks" IconSize="28" Weight="Medium" />
                            <icons:CampusIcon Symbol="tasks" IconSize="28" Weight="Semibold" />
                            <icons:CampusIcon Symbol="tasks" IconSize="28" Weight="Bold" />
                            <TextBlock Text="{l:T Key=six.weights}" Style="{StaticResource Text.Footnote}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl x:Name="IconGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel ItemSpacing="4" LineSpacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </controls:SettingsSection>

                <!-- ======================================================== BRAND -->
                <controls:SettingsSection
                    Header="{l:T Key=brand}"
                    Footer="{l:T Key=the.mark.and.the.wordmark.are.geometry.so.they.cb2bcc}">
                    <StackPanel Padding="16" Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                            <brand:CampusLogo Form="Mark" LogoHeight="64" />
                            <brand:CampusLogo Form="Mark" LogoHeight="32" VerticalAlignment="Center" />
                            <brand:CampusLogo Form="Mark" LogoHeight="16" VerticalAlignment="Center" />
                        </StackPanel>
                        <brand:CampusLogo Form="Wordmark" LogoHeight="28" HorizontalAlignment="Left" />
                        <brand:CampusLogo Form="Lockup" LogoHeight="44" HorizontalAlignment="Left" />
                    </StackPanel>
                </controls:SettingsSection>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
