<Page
    x:Class="Campus.Desktop.Views.ThemeGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Campus.Desktop.Design.Controls"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    xmlns:brand="using:Campus.Desktop.Design.Brand"
    Background="{ThemeResource Theme.GroupedBackground.Primary}">

    <!--
        The theme in one place. Every role, every state, every component, so the whole system
        can be reviewed at once instead of hunting for a screen that happens to use a token.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sticky header: the appearance switch lives with the thing it changes. -->
        <Grid Padding="24,16,24,16" Background="{ThemeResource Theme.GroupedBackground.Primary}">
            <Border VerticalAlignment="Bottom" Height="1"
                    Background="{ThemeResource Theme.Separator.Standard}" />
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Icon}" Click="OnBackClick"
                        AutomationProperties.Name="Back">
                    <icons:CampusIcon Symbol="chevron.left" IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
                <TextBlock Text="Theme Gallery" Style="{StaticResource Text.Title2}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <RadioButton x:Name="ModeSystem" Content="System" GroupName="GalleryMode"
                             Checked="OnModeChanged" Tag="System" />
                <RadioButton x:Name="ModeLight" Content="Light" GroupName="GalleryMode"
                             Checked="OnModeChanged" Tag="Light" />
                <RadioButton x:Name="ModeDark" Content="Dark" GroupName="GalleryMode"
                             Checked="OnModeChanged" Tag="Dark" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="0,0,0,60">
            <StackPanel MaxWidth="860" Margin="24,24,24,0" HorizontalAlignment="Stretch">

                <!-- ================================================== BACKGROUNDS -->
                <controls:SettingsSection
                    Header="BACKGROUND"
                    Footer="Canvas levels. In dark these run #000000, #1C1C1E, #2C2C2E — neutral, with no blue in them.">
                    <StackPanel x:Name="BackgroundSwatches" Padding="16" Spacing="10" />
                </controls:SettingsSection>

                <controls:SettingsSection
                    Header="GROUPED BACKGROUND"
                    Footer="What a Settings-style page paints, and what its sections paint on top.">
                    <StackPanel x:Name="GroupedSwatches" Padding="16" Spacing="10" />
                </controls:SettingsSection>

                <controls:SettingsSection
                    Header="SURFACE"
                    Footer="Raising an element raises its surface. Depth comes from level, not from a border.">
                    <StackPanel x:Name="SurfaceSwatches" Padding="16" Spacing="10" />
                </controls:SettingsSection>

                <!-- ======================================================= LABELS -->
                <controls:SettingsSection
                    Header="LABEL"
                    Footer="Text hierarchy is real opacity, not four hand-picked greys.">
                    <StackPanel Padding="16" Spacing="8">
                        <TextBlock Text="Primary — the thing you are reading"
                                   Foreground="{ThemeResource Theme.Label.Primary}"
                                   FontSize="{StaticResource Theme.Text.Body}" />
                        <TextBlock Text="Secondary — the sentence underneath it"
                                   Foreground="{ThemeResource Theme.Label.Secondary}"
                                   FontSize="{StaticResource Theme.Text.Body}" />
                        <TextBlock Text="Tertiary — metadata and placeholders"
                                   Foreground="{ThemeResource Theme.Label.Tertiary}"
                                   FontSize="{StaticResource Theme.Text.Body}" />
                        <TextBlock Text="Quaternary — the faintest thing still on screen"
                                   Foreground="{ThemeResource Theme.Label.Quaternary}"
                                   FontSize="{StaticResource Theme.Text.Body}" />
                    </StackPanel>
                </controls:SettingsSection>

                <!-- ================================================== TYPOGRAPHY -->
                <controls:SettingsSection
                    Header="TYPOGRAPHY"
                    Footer="Large text uses the display face and reading sizes the text face, so glyphs are optically corrected per size.">
                    <StackPanel Padding="16" Spacing="6">
                        <TextBlock Text="Large Title" Style="{StaticResource Text.LargeTitle}" />
                        <TextBlock Text="Title 1" Style="{StaticResource Text.Title1}" />
                        <TextBlock Text="Title 2" Style="{StaticResource Text.Title2}" />
                        <TextBlock Text="Title 3" Style="{StaticResource Text.Title3}" />
                        <TextBlock Text="Headline" Style="{StaticResource Text.Headline}" />
                        <TextBlock Text="Body — the size everything long is set in." Style="{StaticResource Text.Body}" />
                        <TextBlock Text="Callout" Style="{StaticResource Text.Callout}" />
                        <TextBlock Text="Footnote" Style="{StaticResource Text.Footnote}" />
                        <TextBlock Text="Caption" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="SECTION HEADER" Style="{StaticResource Text.SectionHeader}" />
                    </StackPanel>
                </controls:SettingsSection>

                <!-- ======================================================== FILLS -->
                <controls:SettingsSection
                    Header="FILL"
                    Footer="Fills are for control backgrounds, hover, pressed and selection. They are never a substitute for a surface.">
                    <StackPanel x:Name="FillSwatches" Padding="16" Spacing="10" />
                </controls:SettingsSection>

                <!-- =================================================== SEPARATORS -->
                <controls:SettingsSection
                    Header="SEPARATOR"
                    Footer="Drawn only where content genuinely abuts. Under Increase Contrast they become opaque.">
                    <StackPanel Padding="16" Spacing="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Standard" Style="{StaticResource Text.Footnote}" />
                            <Border Height="1" Background="{ThemeResource Theme.Separator.Standard}" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Opaque" Style="{StaticResource Text.Footnote}" />
                            <Border Height="1" Background="{ThemeResource Theme.Separator.Opaque}" />
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsSection>

                <!-- ====================================================== BUTTONS -->
                <controls:SettingsSection
                    Header="BUTTONS"
                    Footer="Blue is the primary action. Red is only for what cannot be undone. Hover and press each have their own role.">
                    <StackPanel Padding="16" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{StaticResource Button.Primary}" Content="Primary" />
                            <Button Style="{StaticResource Button.Secondary}" Content="Secondary" />
                            <Button Style="{StaticResource Button.Plain}" Content="Plain" />
                            <Button Style="{StaticResource Button.Destructive}" Content="Delete" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{StaticResource Button.Primary}" Content="Disabled" IsEnabled="False" />
                            <Button Style="{StaticResource Button.Secondary}" Content="Disabled" IsEnabled="False" />
                            <Button Style="{StaticResource Button.Destructive}" Content="Disabled" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Style="{StaticResource Button.Icon}" AutomationProperties.Name="Add">
                                <icons:CampusIcon Symbol="add" IconSize="{StaticResource Theme.Icon.XL}" />
                            </Button>
                            <Button Style="{StaticResource Button.Icon}" AutomationProperties.Name="Search">
                                <icons:CampusIcon Symbol="search" IconSize="{StaticResource Theme.Icon.L}" />
                            </Button>
                            <Button Style="{StaticResource Button.Icon}" AutomationProperties.Name="Star">
                                <icons:CampusIcon Symbol="star" IconSize="{StaticResource Theme.Icon.L}" />
                            </Button>
                            <Button Style="{StaticResource Button.IconLarge}" AutomationProperties.Name="Print">
                                <icons:CampusIcon Symbol="print" IconSize="{StaticResource Theme.Icon.XXL}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsSection>

                <!-- ======================================================= INPUTS -->
                <controls:SettingsSection Header="INPUTS">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBox Style="{StaticResource Input.Text}" PlaceholderText="Title"
                                 AutomationProperties.Name="Title" />
                        <TextBox Style="{StaticResource Input.Search}" PlaceholderText="Search everything"
                                 AutomationProperties.Name="Search" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <CheckBox Content="Checkbox" />
                            <CheckBox Content="Checked" IsChecked="True" />
                            <CheckBox Content="Disabled" IsEnabled="False" />
                            <ToggleSwitch OnContent="" OffContent="" IsOn="True"
                                          AutomationProperties.Name="Sample toggle" />
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsSection>

                <!-- =============================================== SETTINGS ROWS -->
                <controls:SettingsSection
                    Header="SETTINGS SECTION"
                    Footer="One surface, hairlines between rows. Not a page of separate cards.">
                    <StackPanel>
                        <controls:SettingsRow Title="Wi-Fi" Symbol="wifi" ShowSeparator="False">
                            <ToggleSwitch OnContent="" OffContent="" IsOn="True"
                                          AutomationProperties.Name="Wi-Fi" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="Local network sync"
                                              Subtitle="Pair a device to turn this on"
                                              Symbol="sync">
                            <ToggleSwitch OnContent="" OffContent=""
                                          AutomationProperties.Name="Local network sync" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="Delete workspace"
                                              Subtitle="This cannot be undone"
                                              Symbol="trash"
                                              IsDestructive="True">
                            <icons:CampusIcon Symbol="chevron.right"
                                              IconSize="{StaticResource Theme.Icon.M}"
                                              Foreground="{ThemeResource Theme.Label.Tertiary}" />
                        </controls:SettingsRow>
                    </StackPanel>
                </controls:SettingsSection>

                <!-- ======================================================= STATES -->
                <controls:SettingsSection
                    Header="SEMANTIC STATES"
                    Footer="Meaning, not decoration: blue acts, red destroys, amber warns, green confirms.">
                    <StackPanel x:Name="StateSwatches" Padding="16" Spacing="10" />
                </controls:SettingsSection>

                <!-- ============================================== SUBJECT ACCENTS -->
                <controls:SettingsSection
                    Header="SUBJECT ACCENTS"
                    Footer="A fixed, calm set. Subjects store the name, never a colour value.">
                    <StackPanel x:Name="SubjectSwatches" Padding="16" Spacing="10" />
                </controls:SettingsSection>

                <!-- ======================================================== ICONS -->
                <controls:SettingsSection
                    Header="ICONS"
                    Footer="Drawn geometry on a 24-unit grid, stroked at render time. Never emoji.">
                    <StackPanel Padding="16" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <icons:CampusIcon Symbol="library" IconSize="12" />
                            <icons:CampusIcon Symbol="library" IconSize="16" />
                            <icons:CampusIcon Symbol="library" IconSize="20" />
                            <icons:CampusIcon Symbol="library" IconSize="24" />
                            <icons:CampusIcon Symbol="library" IconSize="32" />
                            <icons:CampusIcon Symbol="library" IconSize="48" />
                            <TextBlock Text="One definition, optically corrected per size"
                                       Style="{StaticResource Text.Footnote}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <icons:CampusIcon Symbol="tasks" IconSize="28" Weight="Ultralight" />
                            <icons:CampusIcon Symbol="tasks" IconSize="28" Weight="Light" />
                            <icons:CampusIcon Symbol="tasks" IconSize="28" Weight="Regular" />
                            <icons:CampusIcon Symbol="tasks" IconSize="28" Weight="Medium" />
                            <icons:CampusIcon Symbol="tasks" IconSize="28" Weight="Semibold" />
                            <icons:CampusIcon Symbol="tasks" IconSize="28" Weight="Bold" />
                            <TextBlock Text="Six weights" Style="{StaticResource Text.Footnote}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl x:Name="IconGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel ItemSpacing="4" LineSpacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </controls:SettingsSection>

                <!-- ======================================================== BRAND -->
                <controls:SettingsSection
                    Header="BRAND"
                    Footer="The mark and the wordmark are geometry, so they take the current label colour and stay exact at any size.">
                    <StackPanel Padding="16" Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                            <brand:CampusLogo Form="Mark" LogoHeight="64" />
                            <brand:CampusLogo Form="Mark" LogoHeight="32" VerticalAlignment="Center" />
                            <brand:CampusLogo Form="Mark" LogoHeight="16" VerticalAlignment="Center" />
                        </StackPanel>
                        <brand:CampusLogo Form="Wordmark" LogoHeight="28" HorizontalAlignment="Left" />
                        <brand:CampusLogo Form="Lockup" LogoHeight="44" HorizontalAlignment="Left" />
                    </StackPanel>
                </controls:SettingsSection>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
