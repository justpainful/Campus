<Page
    x:Class="Campus.Desktop.Views.SubjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Campus.Desktop.Localization"
    xmlns:controls="using:Campus.Desktop.Design.Controls"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    Background="{ThemeResource Theme.Background.Primary}">

    <!--
        The subjects, as a board rather than a list. A subject is the thing everything else hangs
        off, and there are six of them, not six hundred — so they get room to show what is
        actually happening inside each one.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="28,20,28,14" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{l:T Key=subjects.1a75}" Style="{StaticResource Text.LargeTitle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Footnote}" />
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource Button.Primary}"
                    Click="OnNewClick" MinWidth="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <icons:CampusIcon Symbol="add" IconSize="{StaticResource Theme.Icon.M}"
                                      Foreground="{ThemeResource Theme.Label.OnAccent}" />
                    <TextBlock Text="{l:T Key=new.subject}" Foreground="{ThemeResource Theme.Label.OnAccent}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="28,0,28,32">
            <StackPanel Spacing="20">
                <controls:WrapPanel x:Name="Cards" ItemSpacing="16" LineSpacing="16" />

                <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="12"
                            HorizontalAlignment="Center" MaxWidth="380" Margin="0,80,0,0">
                    <Border Width="64" Height="64" HorizontalAlignment="Center"
                            CornerRadius="{StaticResource Theme.Radius.Surface}"
                            Background="{ThemeResource Theme.Fill.Quaternary}">
                        <icons:CampusIcon Symbol="subjects" IconSize="{StaticResource Theme.Icon.Display}"
                                          Weight="Light"
                                          Foreground="{ThemeResource Theme.Label.Tertiary}" />
                    </Border>
                    <TextBlock Text="{l:T Key=no.subjects.yet}" Style="{StaticResource Text.Title3}"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Callout}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Text="{l:T Key=a.subject.is.the.shelf.everything.else.sits.on.2c3f0b}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
