<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    xmlns:brand="using:Campus.Desktop.Design.Brand"
    xmlns:design="using:Campus.Desktop.Design"
    xmlns:controls="using:Campus.Desktop.Design.Controls">

    <design:StringToVisibilityConverter x:Key="StringToVisibility" />
    <design:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <design:DestructiveLabelConverter x:Key="DestructiveLabel" />
    <design:ThemeRoleConverter x:Key="ThemeRole" />

    <!--
        CampusIcon. The template is deliberately bare: a single Path whose geometry, stroke and
        scale are set in code so one definition serves every size and weight. Stroke caps and
        joins are round, which is what gives the drawings their SF-Symbols-like softness.
    -->
    <Style TargetType="icons:CampusIcon">
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="icons:CampusIcon">
                    <Grid>
                        <Path
                            x:Name="PART_Path"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        CampusLogo. A bare canvas the control fills with the generated geometry; the shapes are
        built in code because the lockup's proportions come from the brand metrics rather than
        from a fixed layout.
    -->
    <Style TargetType="brand:CampusLogo">
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="brand:CampusLogo">
                    <Canvas x:Name="PART_Canvas" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        SettingsSection. Header, one rounded surface, footnote. The surface comes from the
        grouped background role, so a section on a grouped page reads as raised without a
        border and without a shadow.
    -->
    <Style TargetType="controls:SettingsSection">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsSection">
                    <StackPanel>
                        <TextBlock
                            Text="{TemplateBinding Header}"
                            Style="{StaticResource Text.SectionHeader}"
                            Margin="16,0,16,7"
                            Visibility="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibility}}" />

                        <Border
                            Background="{ThemeResource Theme.GroupedBackground.Secondary}"
                            CornerRadius="{StaticResource Theme.Radius.Section}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="Stretch" />
                        </Border>

                        <TextBlock
                            Text="{TemplateBinding Footer}"
                            Style="{StaticResource Text.Footnote}"
                            Foreground="{ThemeResource Theme.Label.Secondary}"
                            Margin="16,7,16,0"
                            Visibility="{Binding Footer, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        SettingsRow. The hairline is drawn at the top of each row and suppressed on the first,
        which gives separators between rows instead of a box around every one.
    -->
    <Style TargetType="controls:SettingsRow">
        <Setter Property="MinHeight" Value="{StaticResource Theme.Size.RowHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsRow">
                    <Grid>
                        <Border
                            VerticalAlignment="Top"
                            Height="1"
                            Margin="16,0,0,0"
                            Background="{ThemeResource Theme.Separator.Standard}"
                            Visibility="{Binding ShowSeparator, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}" />

                        <Grid Padding="16,10,16,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <icons:CampusIcon
                                Grid.Column="0"
                                Symbol="{TemplateBinding Symbol}"
                                IconSize="{StaticResource Theme.Icon.XL}"
                                Foreground="{ThemeResource Theme.Label.Secondary}"
                                VerticalAlignment="Center"
                                Visibility="{Binding Symbol, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibility}}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    Text="{TemplateBinding Title}"
                                    FontFamily="{StaticResource Theme.Font.Text}"
                                    FontSize="{StaticResource Theme.Text.Body}"
                                    Foreground="{Binding IsDestructive, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DestructiveLabel}}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{TemplateBinding Subtitle}"
                                    Style="{StaticResource Text.Footnote}"
                                    Visibility="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>

                            <ContentPresenter
                                Grid.Column="2"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        SplitterBar. One hairline wide at rest; the hit area is widened with padding so it is
        grabbable without drawing a thick bar, and it brightens on hover and focus.
    -->
    <Style TargetType="controls:SplitterBar">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{ThemeResource Theme.Separator.Standard}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource Theme.Focused.Ring}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource Theme.Focused.RingOuter}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SplitterBar">
                    <Grid Background="Transparent">
                        <Border x:Name="Line" Background="{TemplateBinding Background}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Line.Background" Value="{ThemeResource Theme.Accent.Primary}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        SegmentedControl. One pill holding the whole group; the selected segment is a raised
        surface inside it rather than a differently-coloured label.
    -->
    <Style TargetType="controls:SegmentedControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SegmentedControl">
                    <Border
                        Background="{ThemeResource Theme.Fill.Quaternary}"
                        CornerRadius="{StaticResource Theme.Radius.M}"
                        Padding="2">
                        <StackPanel x:Name="PART_Panel" Orientation="Horizontal" Spacing="2" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
