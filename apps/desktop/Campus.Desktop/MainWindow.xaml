<Window
    x:Class="Campus.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Campus.Desktop.Shell"
    xmlns:icons="using:Campus.Desktop.Design.Icons"
    xmlns:brand="using:Campus.Desktop.Design.Brand"
    xmlns:controls="using:Campus.Desktop.Design.Controls">

    <Grid x:Name="RootLayout" Background="{ThemeResource Theme.Background.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ TITLE BAR -->
        <!--
            The window's own chrome is extended into, so the title bar is ours: the mark on the
            left, the workspace name centred, and the actions that belong to the window rather
            than to any one page on the right.
        -->
        <Grid x:Name="AppTitleBar"
              Height="{StaticResource Theme.Size.TitleBarHeight}"
              Background="{ThemeResource Theme.Background.Primary}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <brand:CampusLogo
                Grid.Column="0"
                Form="Lockup"
                LogoHeight="20"
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource Theme.Label.Primary}" />

            <!-- Centre: the workspace this window is showing. -->
            <StackPanel
                x:Name="TitleCentre"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <icons:CampusIcon
                    Symbol="lock"
                    IconSize="{StaticResource Theme.Icon.S}"
                    Foreground="{ThemeResource Theme.Label.Tertiary}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="WorkspaceLabel"
                    Text="Campus Workspace"
                    Style="{StaticResource Text.Footnote}"
                    Foreground="{ThemeResource Theme.Label.Secondary}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Right: window-level actions, kept clear of the system caption buttons. -->
            <StackPanel
                x:Name="TitleActions"
                Grid.Column="4"
                Orientation="Horizontal"
                Spacing="2"
                Margin="0,0,8,0"
                VerticalAlignment="Center">
                <Button
                    x:Name="CommandPaletteButton"
                    Style="{StaticResource Button.Icon}"
                    Click="OnCommandPaletteClick"
                    AutomationProperties.Name="Command palette"
                    ToolTipService.ToolTip="Command Palette  (Ctrl+Shift+P)">
                    <icons:CampusIcon Symbol="command" IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
                <Button
                    x:Name="QuickCaptureButton"
                    Style="{StaticResource Button.Icon}"
                    Click="OnQuickCaptureClick"
                    AutomationProperties.Name="Quick capture"
                    ToolTipService.ToolTip="Quick Capture  (Ctrl+Alt+N)">
                    <icons:CampusIcon Symbol="add" IconSize="{StaticResource Theme.Icon.XL}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
                <Button
                    x:Name="LockButton"
                    Style="{StaticResource Button.Icon}"
                    Click="OnLockClick"
                    AutomationProperties.Name="Lock Campus"
                    ToolTipService.ToolTip="Lock Campus  (Ctrl+Shift+L)">
                    <icons:CampusIcon Symbol="lock" IconSize="{StaticResource Theme.Icon.L}"
                                      Foreground="{ThemeResource Theme.Label.Secondary}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================================================================= BODY -->
        <Grid x:Name="BodyLayout" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SidebarColumn" Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="InspectorColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <shell:ActivityBar x:Name="Rail" Grid.Column="0" />

            <!-- ========================================================== SIDEBAR -->
            <Grid x:Name="Sidebar" Grid.Column="1"
                  Background="{ThemeResource Theme.Background.Secondary}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Height="38" Padding="16,0,8,0">
                    <TextBlock
                        x:Name="SidebarTitle"
                        Text="HOME"
                        Style="{StaticResource Text.SectionHeader}"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="SidebarAction"
                        Style="{StaticResource Button.Icon}"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="More actions"
                        ToolTipService.ToolTip="More actions">
                        <icons:CampusIcon Symbol="more" IconSize="{StaticResource Theme.Icon.M}"
                                          Foreground="{ThemeResource Theme.Label.Secondary}" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="8,0,8,12">
                    <ContentPresenter x:Name="SidebarContent" />
                </ScrollViewer>
            </Grid>

            <!-- Draggable divider between the sidebar and the workspace. -->
            <controls:SplitterBar
                x:Name="SidebarGrip"
                Grid.Column="2"
                Orientation="Vertical"
                Dragged="OnSidebarResize"
                AutomationProperties.Name="Resize sidebar" />

            <!-- ======================================================== WORKSPACE -->
            <Grid Grid.Column="3" Background="{ThemeResource Theme.Background.Primary}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tab strip. Hidden until something is open, so an empty workspace is calm. -->
                <Grid x:Name="TabStrip"
                      Height="{StaticResource Theme.Size.TabHeight}"
                      Visibility="Collapsed">
                    <Border VerticalAlignment="Bottom" Height="1"
                            Background="{ThemeResource Theme.Separator.Standard}" />
                    <ScrollViewer HorizontalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl x:Name="Tabs">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>

            <controls:SplitterBar
                x:Name="InspectorGrip"
                Grid.Column="4"
                Orientation="Vertical"
                Visibility="Collapsed"
                Dragged="OnInspectorResize"
                AutomationProperties.Name="Resize inspector" />

            <!-- ======================================================== INSPECTOR -->
            <Grid x:Name="Inspector" Grid.Column="5"
                  Background="{ThemeResource Theme.Background.Secondary}"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Height="38" Padding="16,0,8,0">
                    <TextBlock Text="DETAILS" Style="{StaticResource Text.SectionHeader}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right"
                            Click="OnInspectorCloseClick"
                            AutomationProperties.Name="Close inspector">
                        <icons:CampusIcon Symbol="close" IconSize="{StaticResource Theme.Icon.M}"
                                          Foreground="{ThemeResource Theme.Label.Secondary}" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" Padding="16,0,16,16">
                    <ContentPresenter x:Name="InspectorContent" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- =========================================================== STATUS BAR -->
        <Grid Grid.Row="2"
              Height="{StaticResource Theme.Size.StatusBarHeight}"
              Background="{ThemeResource Theme.Background.Primary}">
            <Border VerticalAlignment="Top" Height="1"
                    Background="{ThemeResource Theme.Separator.Standard}" />
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="14,0,0,0"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <icons:CampusIcon Symbol="lock" IconSize="{StaticResource Theme.Icon.XS}"
                                      Foreground="{ThemeResource Theme.Success.Primary}"
                                      VerticalAlignment="Center" />
                    <TextBlock x:Name="VaultStatus" Text="Vault unlocked"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SyncStatus" Text="No devices paired"
                           Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,14,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ItemCount" Text="" Style="{StaticResource Text.Caption}" />
                <TextBlock x:Name="AppearanceStatus" Text="" Style="{StaticResource Text.Caption}" />
            </StackPanel>
        </Grid>
        <!--
            The lock screen covers the workspace and the status bar but not the title bar, so the
            window can still be moved, minimised and closed while it is locked.
        -->
        <Frame
            x:Name="LockFrame"
            Grid.Row="1"
            Grid.RowSpan="2"
            Background="{ThemeResource Theme.Background.Primary}"
            Visibility="Collapsed" />
    </Grid>
</Window>
