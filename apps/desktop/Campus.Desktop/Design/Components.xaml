<!--
    Campus — Component roles

    Every style here is written in theme roles only. Not one literal colour appears below this
    line; if a component needs a new colour, the role goes into Theme.xaml and the component
    refers to it by name.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================== TYPOGRAPHY -->
    <Style x:Key="Text.LargeTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.LargeTitle}" />
        <Setter Property="LineHeight" Value="{StaticResource Theme.Leading.LargeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Title1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Title1}" />
        <Setter Property="LineHeight" Value="{StaticResource Theme.Leading.Title1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Title2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Title2}" />
        <Setter Property="LineHeight" Value="{StaticResource Theme.Leading.Title2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Title3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Title3}" />
        <Setter Property="LineHeight" Value="{StaticResource Theme.Leading.Title3}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Headline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Headline}" />
        <Setter Property="LineHeight" Value="{StaticResource Theme.Leading.Headline}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Body}" />
        <Setter Property="LineHeight" Value="{StaticResource Theme.Leading.Body}" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Callout" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Callout}" />
        <Setter Property="LineHeight" Value="{StaticResource Theme.Leading.Callout}" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Subheadline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Subheadline}" />
        <Setter Property="LineHeight" Value="{StaticResource Theme.Leading.Callout}" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Footnote" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Small}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Footnote}" />
        <Setter Property="LineHeight" Value="{StaticResource Theme.Leading.Footnote}" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Small}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Caption1}" />
        <Setter Property="LineHeight" Value="{StaticResource Theme.Leading.Caption}" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Tertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Section headers above a grouped list. Small, quiet, and never shouty. -->
    <Style x:Key="Text.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Small}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Footnote}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Secondary}" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Callout}" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
    </Style>

    <!-- ================================================================= BUTTONS -->
    <!--
        One template shape per role. A single shared template would need the hover and pressed
        fills passed in as attached properties, which VisualState setters cannot bind to
        reliably — so each role states its own three fills explicitly and there is no
        indirection to get wrong.
    -->
    <ControlTemplate x:Key="Template.Button.Primary" TargetType="Button">
        <Grid>
            <Border x:Name="Root"
                    Background="{ThemeResource Theme.Accent.Primary}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource Theme.Accent.Hover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource Theme.Accent.Pressed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource Theme.Disabled.Fill}" />
                            <Setter Target="Presenter.Foreground" Value="{ThemeResource Theme.Disabled.Label}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="Template.Button.Secondary" TargetType="Button">
        <Grid>
            <Border x:Name="Root"
                    Background="{ThemeResource Theme.Fill.Tertiary}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource Theme.Fill.Secondary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource Theme.Fill.Primary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource Theme.Disabled.Fill}" />
                            <Setter Target="Presenter.Foreground" Value="{ThemeResource Theme.Disabled.Label}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="Template.Button.Plain" TargetType="Button">
        <Grid>
            <Border x:Name="Root"
                    Background="Transparent"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource Theme.Fill.Quaternary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource Theme.Fill.Tertiary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Foreground" Value="{ThemeResource Theme.Disabled.Label}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="Template.Button.Destructive" TargetType="Button">
        <Grid>
            <Border x:Name="Root"
                    Background="{ThemeResource Theme.Destructive.Primary}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource Theme.Destructive.Hover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource Theme.Destructive.Pressed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource Theme.Disabled.Fill}" />
                            <Setter Target="Presenter.Foreground" Value="{ThemeResource Theme.Disabled.Label}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- The primary action on a surface. Blue, the way a system primary button is blue. -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Theme.Accent.Primary}" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.OnAccent}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Theme.Accent.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Theme.Padding.Button}" />
        <Setter Property="MinHeight" Value="{StaticResource Theme.Size.ControlHeightComfortable}" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource Theme.Focused.Ring}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource Theme.Focused.RingOuter}" />
        <Setter Property="Template" Value="{StaticResource Template.Button.Primary}" />
    </Style>

    <!-- A visible but secondary control: neutral fill, primary label. -->
    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Theme.Fill.Tertiary}" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Theme.Padding.Button}" />
        <Setter Property="MinHeight" Value="{StaticResource Theme.Size.ControlHeightComfortable}" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource Theme.Focused.Ring}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource Theme.Focused.RingOuter}" />
        <Setter Property="Template" Value="{StaticResource Template.Button.Secondary}" />
    </Style>

    <!-- Transparent until touched. Toolbars, list rows, icon buttons. -->
    <Style x:Key="Button.Plain" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.S}" />
        <Setter Property="Padding" Value="{StaticResource Theme.Padding.ButtonCompact}" />
        <Setter Property="MinHeight" Value="{StaticResource Theme.Size.ControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource Theme.Focused.Ring}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource Theme.Focused.RingOuter}" />
        <Setter Property="Template" Value="{StaticResource Template.Button.Plain}" />
    </Style>

    <!-- Irreversible actions. Red, and never used for anything reversible. -->
    <Style x:Key="Button.Destructive" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Theme.Destructive.Primary}" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Theme.Padding.Button}" />
        <Setter Property="MinHeight" Value="{StaticResource Theme.Size.ControlHeightComfortable}" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource Theme.Focused.Ring}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource Theme.Focused.RingOuter}" />
        <Setter Property="Template" Value="{StaticResource Template.Button.Destructive}" />
    </Style>

    <!-- A square icon button sized for a comfortable pointer target. -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Plain}">
        <Setter Property="Width" Value="{StaticResource Theme.Size.ControlHeight}" />
        <Setter Property="Height" Value="{StaticResource Theme.Size.ControlHeight}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Button.IconLarge" TargetType="Button" BasedOn="{StaticResource Button.Plain}">
        <Setter Property="Width" Value="{StaticResource Theme.Size.TouchTarget}" />
        <Setter Property="Height" Value="{StaticResource Theme.Size.TouchTarget}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.M}" />
    </Style>

    <!-- =============================================================== SURFACES -->
    <!-- A grouped section: one surface, rounded once, rows separated inside it. -->
    <Style x:Key="Surface.Section" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Theme.GroupedBackground.Secondary}" />
        <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.Section}" />
    </Style>

    <Style x:Key="Surface.Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Theme.Surface.Primary}" />
        <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Theme.Padding.Card}" />
    </Style>

    <Style x:Key="Surface.Elevated" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Theme.Surface.Elevated}" />
        <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.Flyout}" />
    </Style>

    <!-- A separator between adjacent rows. Not a border around every row. -->
    <Style x:Key="Separator.Row" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Theme.Separator.Standard}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="Separator.Vertical" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Theme.Separator.Standard}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- ================================================================= INPUTS -->
    <Style x:Key="Input.Text" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource Theme.Fill.Tertiary}" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="PlaceholderForeground" Value="{ThemeResource Theme.Label.Tertiary}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource Theme.Color.Accent.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Theme.Padding.Field}" />
        <Setter Property="MinHeight" Value="{StaticResource Theme.Size.ControlHeightComfortable}" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Body}" />
    </Style>

    <Style x:Key="Input.Search" TargetType="TextBox" BasedOn="{StaticResource Input.Text}">
        <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.M}" />
        <Setter Property="Background" Value="{ThemeResource Theme.Fill.Quaternary}" />
    </Style>

    <Style TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Body}" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Body}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource Theme.Size.ControlHeight}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Body}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource Theme.Size.ControlHeight}" />
    </Style>

    <!-- ============================================================== SEGMENTS -->
    <!--
        One segment. Unselected segments are transparent so the group reads as a single pill;
        the selected one gets a raised surface, and both states keep the same label colour so
        selection never depends on a colour difference alone.
    -->
    <Style x:Key="Segment.Button" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Secondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Theme.Radius.S}" />
        <Setter Property="Padding" Value="14,5,14,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Callout}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource Theme.Focused.Ring}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource Theme.Focused.RingOuter}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="Presenter"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Theme.Fill.Quaternary}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource Theme.Label.Primary}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Theme.Fill.Tertiary}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Theme.Surface.Tertiary}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource Theme.Label.Primary}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Theme.Surface.Tertiary}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource Theme.Label.Primary}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Theme.Surface.Secondary}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource Theme.Label.Primary}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource Theme.Disabled.Label}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ DEFAULTS -->
    <!-- Bare TextBlocks inherit the reading size and primary label, so nothing is left unstyled. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Text.Body}" />
        <Setter Property="Foreground" Value="{ThemeResource Theme.Label.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
