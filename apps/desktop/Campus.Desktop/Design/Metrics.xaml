<!--
    Campus — Metrics

    Spacing, radius, sizing and typography. Deliberately a separate system from colour: a
    component asks for Theme.Radius.Card and Theme.Surface.Secondary independently, and neither
    system dictates the other.

    Typography follows Apple's optical approach on the Windows system family: Segoe UI Variable
    Display for large text, Segoe UI Variable Text for reading sizes, so glyphs are optically
    corrected per size rather than one face scaled up and down.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================== SPACING -->
    <x:Double x:Key="Theme.Space.XXS">2</x:Double>
    <x:Double x:Key="Theme.Space.XS">4</x:Double>
    <x:Double x:Key="Theme.Space.S">8</x:Double>
    <x:Double x:Key="Theme.Space.M">12</x:Double>
    <x:Double x:Key="Theme.Space.L">16</x:Double>
    <x:Double x:Key="Theme.Space.XL">20</x:Double>
    <x:Double x:Key="Theme.Space.XXL">24</x:Double>
    <x:Double x:Key="Theme.Space.XXXL">32</x:Double>
    <x:Double x:Key="Theme.Space.Huge">48</x:Double>

    <Thickness x:Key="Theme.Padding.Page">24,20,24,24</Thickness>
    <Thickness x:Key="Theme.Padding.Section">16</Thickness>
    <Thickness x:Key="Theme.Padding.Row">16,10,16,10</Thickness>
    <Thickness x:Key="Theme.Padding.RowCompact">12,6,12,6</Thickness>
    <Thickness x:Key="Theme.Padding.Card">16</Thickness>
    <Thickness x:Key="Theme.Padding.Button">16,7,16,7</Thickness>
    <Thickness x:Key="Theme.Padding.ButtonCompact">12,5,12,5</Thickness>
    <Thickness x:Key="Theme.Padding.Field">12,7,12,7</Thickness>
    <Thickness x:Key="Theme.Padding.Flyout">8</Thickness>

    <!-- ============================================================== RADIUS -->
    <!-- Small controls stay tight; grouped surfaces get the softer Apple-style corner. -->
    <CornerRadius x:Key="Theme.Radius.None">0</CornerRadius>
    <CornerRadius x:Key="Theme.Radius.XS">4</CornerRadius>
    <CornerRadius x:Key="Theme.Radius.S">6</CornerRadius>
    <CornerRadius x:Key="Theme.Radius.M">8</CornerRadius>
    <CornerRadius x:Key="Theme.Radius.Control">7</CornerRadius>
    <CornerRadius x:Key="Theme.Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Theme.Radius.Section">10</CornerRadius>
    <CornerRadius x:Key="Theme.Radius.Surface">12</CornerRadius>
    <CornerRadius x:Key="Theme.Radius.Dialog">12</CornerRadius>
    <CornerRadius x:Key="Theme.Radius.Flyout">10</CornerRadius>
    <CornerRadius x:Key="Theme.Radius.Pill">999</CornerRadius>

    <!-- Section corners: only the outer edges of a grouped list are rounded. -->
    <CornerRadius x:Key="Theme.Radius.SectionTop">10,10,0,0</CornerRadius>
    <CornerRadius x:Key="Theme.Radius.SectionBottom">0,0,10,10</CornerRadius>

    <!-- =============================================================== SIZING -->
    <x:Double x:Key="Theme.Size.ControlHeightCompact">28</x:Double>
    <x:Double x:Key="Theme.Size.ControlHeight">32</x:Double>
    <x:Double x:Key="Theme.Size.ControlHeightComfortable">36</x:Double>
    <x:Double x:Key="Theme.Size.RowHeight">44</x:Double>
    <x:Double x:Key="Theme.Size.RowHeightCompact">34</x:Double>
    <x:Double x:Key="Theme.Size.TouchTarget">44</x:Double>

    <x:Double x:Key="Theme.Size.ActivityBarWidth">56</x:Double>
    <x:Double x:Key="Theme.Size.ActivityItem">44</x:Double>
    <x:Double x:Key="Theme.Size.SidebarWidth">280</x:Double>
    <x:Double x:Key="Theme.Size.SidebarMinWidth">200</x:Double>
    <x:Double x:Key="Theme.Size.SidebarMaxWidth">480</x:Double>
    <x:Double x:Key="Theme.Size.InspectorWidth">300</x:Double>
    <x:Double x:Key="Theme.Size.InspectorMinWidth">240</x:Double>
    <x:Double x:Key="Theme.Size.InspectorMaxWidth">460</x:Double>
    <x:Double x:Key="Theme.Size.TitleBarHeight">40</x:Double>
    <x:Double x:Key="Theme.Size.TabHeight">36</x:Double>
    <x:Double x:Key="Theme.Size.StatusBarHeight">24</x:Double>
    <x:Double x:Key="Theme.Size.SeparatorThickness">1</x:Double>

    <!-- Icon optical sizes. Icons are drawn geometry, so these are true sizes, not font sizes. -->
    <x:Double x:Key="Theme.Icon.XS">12</x:Double>
    <x:Double x:Key="Theme.Icon.S">14</x:Double>
    <x:Double x:Key="Theme.Icon.M">16</x:Double>
    <x:Double x:Key="Theme.Icon.L">18</x:Double>
    <x:Double x:Key="Theme.Icon.XL">20</x:Double>
    <x:Double x:Key="Theme.Icon.XXL">24</x:Double>
    <x:Double x:Key="Theme.Icon.Display">32</x:Double>
    <x:Double x:Key="Theme.Icon.Hero">48</x:Double>

    <!-- =========================================================== TYPOGRAPHY -->
    <FontFamily x:Key="Theme.Font.Display">Segoe UI Variable Display, Segoe UI, Segoe UI Variable</FontFamily>
    <FontFamily x:Key="Theme.Font.Text">Segoe UI Variable Text, Segoe UI, Segoe UI Variable</FontFamily>
    <FontFamily x:Key="Theme.Font.Small">Segoe UI Variable Small, Segoe UI, Segoe UI Variable</FontFamily>
    <FontFamily x:Key="Theme.Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <!--
        Only used for emoji typed into a plain text field, where the platform picks the face.
        Everything Campus draws itself goes through an emoji pack instead. Apple is listed
        first so that installing that font into Windows fixes text fields too.
    -->
    <FontFamily x:Key="Theme.Font.Emoji">Apple Color Emoji, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="Theme.Font.Arabic">Segoe UI, Tahoma, Arial</FontFamily>
    <!-- Opt-in reading face for the dyslexia-friendly accessibility setting. -->
    <FontFamily x:Key="Theme.Font.Reading">Verdana, Segoe UI, Tahoma</FontFamily>

    <x:Double x:Key="Theme.Text.LargeTitle">30</x:Double>
    <x:Double x:Key="Theme.Text.Title1">24</x:Double>
    <x:Double x:Key="Theme.Text.Title2">20</x:Double>
    <x:Double x:Key="Theme.Text.Title3">17</x:Double>
    <x:Double x:Key="Theme.Text.Headline">15</x:Double>
    <x:Double x:Key="Theme.Text.Body">14</x:Double>
    <x:Double x:Key="Theme.Text.Callout">13</x:Double>
    <x:Double x:Key="Theme.Text.Subheadline">13</x:Double>
    <x:Double x:Key="Theme.Text.Footnote">12</x:Double>
    <x:Double x:Key="Theme.Text.Caption1">11</x:Double>
    <x:Double x:Key="Theme.Text.Caption2">10</x:Double>

    <x:Double x:Key="Theme.Leading.LargeTitle">36</x:Double>
    <x:Double x:Key="Theme.Leading.Title1">30</x:Double>
    <x:Double x:Key="Theme.Leading.Title2">26</x:Double>
    <x:Double x:Key="Theme.Leading.Title3">22</x:Double>
    <x:Double x:Key="Theme.Leading.Headline">20</x:Double>
    <x:Double x:Key="Theme.Leading.Body">20</x:Double>
    <x:Double x:Key="Theme.Leading.Callout">18</x:Double>
    <x:Double x:Key="Theme.Leading.Footnote">16</x:Double>
    <x:Double x:Key="Theme.Leading.Caption">14</x:Double>

    <!-- ================================================================ MOTION -->
    <!-- Short, physical, interruptible. All of these collapse to zero when Reduce Motion is on. -->
    <x:Double x:Key="Theme.Motion.Instant">0</x:Double>
    <x:Double x:Key="Theme.Motion.Fast">120</x:Double>
    <x:Double x:Key="Theme.Motion.Normal">200</x:Double>
    <x:Double x:Key="Theme.Motion.Slow">320</x:Double>

    <!-- ================================================================ SHADOW -->
    <!-- Depth is carried by surface level; shadow is reserved for genuinely floating things. -->
    <x:Double x:Key="Theme.Shadow.Flyout">16</x:Double>
    <x:Double x:Key="Theme.Shadow.Dialog">32</x:Double>
    <x:Double x:Key="Theme.Shadow.Dragged">24</x:Double>

</ResourceDictionary>
