            <Color x:Key="SystemAccentColorLight1">#FF3D9BFF</Color>
            <Color x:Key="SystemAccentColorLight2">#FF6FB4FF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFA1CDFF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF0870D6</Color>
            <Color x:Key="SystemAccentColorDark2">#FF065CAD</Color>
            <Color x:Key="SystemAccentColorDark3">#FF054784</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF0A84FF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF409CFF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF0060DF" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#2E747480" />

            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF0A84FF" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF409CFF" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF0060DF" />
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#4DFFFFFF" />

            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FFFFFFFF" />

        </ResourceDictionary>

