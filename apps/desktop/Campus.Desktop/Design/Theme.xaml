<!--
    Campus — Base Semantic Theme

    This file is the ONE place in the application where a literal colour value may appear.
    Everything else refers to a role: Theme.Surface.Secondary, Theme.Label.Primary,
    Theme.Fill.Tertiary. A component never learns what colour it is actually painted.

    Structure mirrors the token tree:
        Background / GroupedBackground / Surface / Label / Fill / Separator
        Accent / Destructive / Success / Warning / Info / Disabled / Selected / Focused

    Dark is built on true black with elevated neutral greys — #000000, #1C1C1E, #2C2C2E, #3A3A3C —
    with no blue tint. Light is built on #FFFFFF content over #F2F2F7 grouped canvas.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ================================================================= DARK -->
        <ResourceDictionary x:Key="Dark">

            <!-- Canvas levels. Level 0 is true black; each step up is a lighter neutral. -->
            <Color x:Key="Theme.Color.Background.Primary">#FF000000</Color>
            <Color x:Key="Theme.Color.Background.Secondary">#FF1C1C1E</Color>
            <Color x:Key="Theme.Color.Background.Tertiary">#FF2C2C2E</Color>

            <!-- Grouped canvas — Settings-style pages sit on the base and float sections above it. -->
            <Color x:Key="Theme.Color.GroupedBackground.Primary">#FF000000</Color>
            <Color x:Key="Theme.Color.GroupedBackground.Secondary">#FF1C1C1E</Color>
            <Color x:Key="Theme.Color.GroupedBackground.Tertiary">#FF2C2C2E</Color>

            <!-- Surfaces. Raising an element raises its surface, not its border weight. -->
            <Color x:Key="Theme.Color.Surface.Primary">#FF1C1C1E</Color>
            <Color x:Key="Theme.Color.Surface.Secondary">#FF2C2C2E</Color>
            <Color x:Key="Theme.Color.Surface.Tertiary">#FF3A3A3C</Color>
            <Color x:Key="Theme.Color.Surface.Elevated">#FF2C2C2E</Color>

            <!-- Text hierarchy. Never plain white below Primary. -->
            <Color x:Key="Theme.Color.Label.Primary">#FFFFFFFF</Color>
            <Color x:Key="Theme.Color.Label.Secondary">#99FFFFFF</Color>
            <Color x:Key="Theme.Color.Label.Tertiary">#4DFFFFFF</Color>
            <Color x:Key="Theme.Color.Label.Quaternary">#2EFFFFFF</Color>
            <Color x:Key="Theme.Color.Label.OnAccent">#FFFFFFFF</Color>

            <!-- Fills — control backgrounds, hover, pressed, selection. Distinct from Surface. -->
            <Color x:Key="Theme.Color.Fill.Primary">#5C787880</Color>
            <Color x:Key="Theme.Color.Fill.Secondary">#52787880</Color>
            <Color x:Key="Theme.Color.Fill.Tertiary">#3D767680</Color>
            <Color x:Key="Theme.Color.Fill.Quaternary">#2E747480</Color>

            <Color x:Key="Theme.Color.Separator.Standard">#99545458</Color>
            <Color x:Key="Theme.Color.Separator.Opaque">#FF38383A</Color>

            <!-- Accent. Interactive things only — never a decorative panel fill. -->
            <Color x:Key="Theme.Color.Accent.Primary">#FF0A84FF</Color>
            <Color x:Key="Theme.Color.Accent.Hover">#FF409CFF</Color>
            <Color x:Key="Theme.Color.Accent.Pressed">#FF0060DF</Color>
            <Color x:Key="Theme.Color.Accent.Disabled">#4D0A84FF</Color>
            <Color x:Key="Theme.Color.Accent.Subtle">#2E0A84FF</Color>

            <Color x:Key="Theme.Color.Destructive.Primary">#FFFF453A</Color>
            <Color x:Key="Theme.Color.Destructive.Hover">#FFFF6961</Color>
            <Color x:Key="Theme.Color.Destructive.Pressed">#FFD70015</Color>
            <Color x:Key="Theme.Color.Destructive.Subtle">#2EFF453A</Color>

            <Color x:Key="Theme.Color.Success.Primary">#FF30D158</Color>
            <Color x:Key="Theme.Color.Success.Subtle">#2E30D158</Color>
            <Color x:Key="Theme.Color.Warning.Primary">#FFFFD60A</Color>
            <Color x:Key="Theme.Color.Warning.Subtle">#2EFFD60A</Color>
            <Color x:Key="Theme.Color.Info.Primary">#FF64D2FF</Color>
            <Color x:Key="Theme.Color.Info.Subtle">#2E64D2FF</Color>

            <Color x:Key="Theme.Color.Disabled.Label">#4DFFFFFF</Color>
            <Color x:Key="Theme.Color.Disabled.Fill">#2E747480</Color>
            <Color x:Key="Theme.Color.Selected.Fill">#3D0A84FF</Color>
            <Color x:Key="Theme.Color.Selected.Rail">#FF0A84FF</Color>
            <Color x:Key="Theme.Color.Focused.Ring">#FFFFFFFF</Color>
            <Color x:Key="Theme.Color.Focused.RingOuter">#FF000000</Color>

            <Color x:Key="Theme.Color.Scrim">#99000000</Color>
            <Color x:Key="Theme.Color.Shadow">#66000000</Color>

            <!-- Subject accents. A fixed, calm set so subjects stay distinguishable without
                 the app turning into a colour chart. -->
            <Color x:Key="Theme.Color.Subject.Blue">#FF0A84FF</Color>
            <Color x:Key="Theme.Color.Subject.Teal">#FF40C8E0</Color>
            <Color x:Key="Theme.Color.Subject.Green">#FF30D158</Color>
            <Color x:Key="Theme.Color.Subject.Indigo">#FF5E5CE6</Color>
            <Color x:Key="Theme.Color.Subject.Orange">#FFFF9F0A</Color>
            <Color x:Key="Theme.Color.Subject.Pink">#FFFF375F</Color>
            <Color x:Key="Theme.Color.Subject.Purple">#FFBF5AF2</Color>
            <Color x:Key="Theme.Color.Subject.Graphite">#FF8E8E93</Color>

            <!-- Annotation highlights, kept legible on a dark page render. -->
            <Color x:Key="Theme.Color.Highlight.Yellow">#66FFD60A</Color>
            <Color x:Key="Theme.Color.Highlight.Green">#6630D158</Color>
            <Color x:Key="Theme.Color.Highlight.Blue">#660A84FF</Color>
            <Color x:Key="Theme.Color.Highlight.Pink">#66FF375F</Color>
            <Color x:Key="Theme.Color.Highlight.Purple">#66BF5AF2</Color>

            <!--
                WinUI's own controls — radio buttons, checkboxes, toggles, sliders, progress —
                paint themselves from the Windows accent colour, which is whatever the user
                picked in Settings and is frequently orange or pink. Campus has one accent, so
                these platform roles are redirected onto it. Without this block the design system
                would govern our components and the platform would govern everything else.
            -->
